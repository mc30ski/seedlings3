enum JobKind {
  ENTIRE_SITE
  SINGLE_ADDRESS
}

enum JobStatus {
  PROPOSED
  ACCEPTED
  PAUSED
  ARCHIVED
}

enum JobOccurrenceStatus {
  SCHEDULED
  IN_PROGRESS
  PAUSED
  STREAM_PAUSED
  COMPLETED
  PENDING_PAYMENT
  CLOSED
  CANCELED
  ARCHIVED
  PROPOSAL_SUBMITTED
  ACCEPTED
  REJECTED
}

enum OccurrenceWorkflow {
  STANDARD
  ONE_OFF
  ESTIMATE
  TASK
  REMINDER
  EVENT
  FOLLOWUP
  ANNOUNCEMENT
}

enum JobOccurrenceSource {
  GENERATED
  MANUAL
}

model Job {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  kind   JobKind   @default(SINGLE_ADDRESS) // REQUIRED
  status JobStatus @default(PROPOSED)

  frequencyDays    Int?
  description      String?
  notes            String?
  defaultPrice     Float?
  estimatedMinutes Int?

  // Default guidance description, seeded onto new occurrences as their
  // editable JobOccurrence.guidanceNote (mirrors the default photo set).
  guidanceNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Bulk-pause bookkeeping — set when this Job was paused as part of a
  // Client-level bulk-pause action ("pause services"). Non-null means
  // "this Job was paused for a bulk reason and should be brought back
  // when the operator hits Resume services on the Client." Null on a
  // paused Job means "individually paused" — bulk-resume leaves it
  // alone, respecting the operator's independent intent. Cleared on
  // bulk-resume or on any manual status flip.
  clientBulkPausedAt   DateTime?
  clientBulkPausedById String?

  // Default crew. EITHER set `defaultGroupId` (and the JobAssigneeDefault
  // list stays empty) OR populate JobAssigneeDefault rows — not both. The
  // mode is enforced in app code (services/jobs.ts). When defaultGroupId
  // is set, new occurrences materialize the group's full roster.
  defaultGroupId String?
  defaultGroup   Group?  @relation("JobDefaultGroup", fields: [defaultGroupId], references: [id], onDelete: SetNull)

  contacts JobContact[]
  clients  JobClient[]

  occurrences            JobOccurrence[]
  defaultAssignees       JobAssigneeDefault[]
  defaultPropertyPhotos  JobPropertyPhoto[]
  followups              FollowupJob[]
  recommendedCollections JobRecommendedCollection[]

  @@index([defaultGroupId])
  @@index([clientBulkPausedAt])
}

model JobContact {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  clientContactId String
  clientContact   ClientContact @relation(fields: [clientContactId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  role   String // "decision_maker" | "on_site" | "notify_only"
  notify Boolean @default(true)

  @@index([jobId])
  @@index([clientContactId])
}

model JobClient {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  role  String // "owner" | "payer" | "point_of_contact"
  share Float? // optional split %

  @@index([jobId])
  @@index([clientId])
}

model JobOccurrence {
  id String @id @default(cuid())

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  kind JobKind? // Copied from Job.kind on creation; null for tasks

  title String? // Short title for tasks; optional for job occurrences

  startAt DateTime?
  endAt   DateTime?

  status   JobOccurrenceStatus @default(SCHEDULED)
  source   JobOccurrenceSource @default(GENERATED)
  workflow OccurrenceWorkflow  @default(STANDARD)

  jobType                    String? // Legacy/custom free-text job type
  jobTags                    String? // JSON array of tags, e.g. ["MOW","TRIM","EDGE","BLOW"]
  notes                      String?
  price                      Float?
  estimatedMinutes           Int?
  frequencyDays              Int? // Overrides Job.frequencyDays when set
  proposalAmount             Float?
  proposalNotes              String?
  rejectionReason            String?
  generatedEstimate          String? // AI-generated estimate message for client
  generatedEstimateBreakdown String? // AI-generated internal cost breakdown for business
  // Light estimate fields (used when jobId is null and workflow is ESTIMATE)
  contactName                String?
  contactPhone               String?
  contactEmail               String?
  estimateAddress            String?

  isOneOff          Boolean @default(false) // @deprecated — use workflow
  isTentative       Boolean @default(false)
  isEstimate        Boolean @default(false) // @deprecated — use workflow
  isAdminOnly       Boolean @default(false)
  isClientConfirmed Boolean @default(false)
  isHighPriority    Boolean @default(false)
  pinnedNote        String?
  pinnedNoteRepeats Boolean @default(true)

  // Optional free-text description for the occurrence's guidance, shown
  // alongside the guidance photos. Carried forward to the next occurrence
  // on close, same as the photos (see payments.ts close→next block).
  guidanceNote String?

  // Payment-request flow (set when occurrence transitions to PENDING_PAYMENT).
  // The token is the URL slug for the public /pay/[token] page; createdAt
  // anchors the expiry (controlled by PAYMENT_REQUEST_TOKEN_EXPIRY_HOURS).
  paymentRequestToken          String?   @unique
  paymentRequestTokenCreatedAt DateTime?
  // Stamped when the Request Payment path is committed: either the worker
  // tapped the button (CLAIMER mode) or sendForOccurrence fired
  // (SERVER mode). Drives the "either-or" workflow on the job card —
  // once set, Accept Payment is hidden and the worker either re-sends
  // or cancels. Cleared by paymentRequests.cancelPaymentRequest.
  // NOTE: this is the LAST-sent timestamp; it moves forward on every
  // re-send. For the immutable original-request time, see
  // paymentRequestFirstSentAt below.
  paymentRequestSentAt         DateTime?
  // Preserved timestamp of the FIRST time this request went out. Written
  // once and never overwritten until the request is cancelled (which
  // clears all three payment-request timestamps, resetting the cycle).
  // Powers the "originally requested N days ago" display.
  paymentRequestFirstSentAt    DateTime?
  // Number of RE-sends since the original request went out (does not
  // count the initial send). Incremented by sendForOccurrence and
  // recordClaimerHandoff whenever paymentRequestFirstSentAt is already
  // set. Reset to 0 by cancelPaymentRequest.
  paymentRequestResendCount    Int       @default(0)

  // Reconciliation hint — the last method the client TAPPED on the
  // public /pay/[token] page (Venmo "Open" button or Zelle "Pay
  // with" modal). Recorded via /public/pay/:token/record-intent
  // fire-and-forget on button click.
  //
  // NOT a payment claim — the client may have tapped and never
  // actually paid, or tapped one method and paid via another. Used
  // as a soft hint on the operator's "Awaiting payment" / "Approve
  // payment" cards so they know where to look when reconciling
  // client payments back to the app. Latest tap wins (bumped on
  // every button press).
  //
  // Method key is the PAYMENT_METHODS taxonomy key (e.g. "VENMO",
  // "ZELLE"). Nullable — null means the client never tapped a
  // button (or they used a method with no button, e.g. Cash/Check).
  paymentIntentMethod String?
  paymentIntentAt     DateTime?

  // Per-worker percentage allocation locked in by the claimer at completion
  // time. Stored as JSON: [{ userId: "...", percent: 50 }, ...]. Drives the
  // PaymentSplit math; survives overpayments (extras distribute pro-rata).
  // Null = even-split fallback applies.
  completionSplits Json?

  // One-time date override for the next repeating occurrence. Set by admins
  // on the CURRENT occurrence when a client has asked to shift ONLY the
  // next visit (e.g. "come one day earlier next time"). YYYY-MM-DD ET
  // calendar day. Consumed at payment-approval time by
  // computeNextOccurrenceStart — when set, replaces the naive
  // startAt + freqDays cycle math with this date at the source
  // occurrence's time-of-day. Only meaningful for repeating jobs
  // (Job.frequencyDays != null); silently ignored for one-offs.
  //
  // The affordance stays visible on the occurrence card as long as no
  // Payment has been confirmed for this occurrence — once approval
  // fires the override is consumed and cannot be edited (the next
  // occurrence has already been generated).
  //
  // Range validation lives at the API + UI: must be strictly AFTER the
  // source occurrence's own date; ±7 days of the normal cadence date
  // saves silently; >7 days OR collision with an existing same-day
  // scheduled occurrence requires typed APPROVE confirmation.
  nextStartOverride String?

  // Immutable snapshot taken when the occurrence is completed with splits.
  // Locks in what each worker is OWED regardless of what the client ends up
  // paying. Used at approval time to top employees/trainees up to their
  // promised net even when the client underpays.
  // Shape: [{ userId, workerType, splitPercent, gross, ratePercent, fee, net }]
  promisedPayouts Json?

  // Latest payment-rejection metadata (denormalized from the audit log so
  // the job card can display the reason without a per-card query). Set by
  // payments.rejectPayment when admin rejects a self-reported payment.
  // Cleared when a payment is approved (occurrence transitions to CLOSED)
  // or the occurrence is reverted to SCHEDULED.
  lastPaymentRejectionReason String?
  lastPaymentRejectedAt      DateTime?

  // Latest payment-revert metadata. Set when admin reverts an already-
  // approved payment (CLOSED → PENDING_PAYMENT) on the Services tab.
  // Same display semantics as the rejection fields above; cleared on the
  // next approved payment.
  lastPaymentRevertReason String?
  lastPaymentRevertedAt   DateTime?

  // "Stream pause" — temporary hold on THIS recurring service under the
  // Job, without stopping the Job's other streams (e.g. pause hedging
  // but keep mowing on a Job that services both). Since the recurring
  // chain regenerates from a completed+paid occurrence, freezing the
  // currently-scheduled occurrence for the stream freezes the whole
  // stream. Resume prompts for a fresh startAt so we don't restart at
  // a stale date.
  //
  // Fields are always set together via services.jobs.pauseStream() /
  // updateStreamPause() / resumeStream(). When status = STREAM_PAUSED:
  //   • Worker feeds hide the row (no dispatch)
  //   • Payment approval refuses to fire (nothing to approve)
  //   • Alerts dropdown + Tasks page surface the reminder when the
  //     `streamResumeReminderAt` date arrives
  //
  // Distinct from `status = PAUSED` which is the WORKER TIMER paused
  // state during an in-progress job — completely different concept.
  streamPausedAt         DateTime?
  streamPausedById       String?
  streamPauseReason      String?
  streamResumeReminderAt DateTime?

  startedAt     DateTime?
  completedAt   DateTime?
  pausedAt      DateTime?
  totalPausedMs Int       @default(0)

  // Payroll-hours approval. Independent of the payment-flow status — a job
  // can be CLOSED (client paid) while hoursApprovedAt is still null. The
  // Gusto W-2 / contractors exports filter on `hoursApprovedAt IS NOT NULL`,
  // so unapproved rows are excluded from payroll until reviewed.
  //
  // Auto-approve rule: when a worker hits Complete, if the variance between
  // actual hours and adjusted estimate is within the warning threshold
  // (currently 30%, matching the visual warning on the card), hoursApprovedAt
  // is stamped immediately. Outside the threshold, it stays null and the
  // occurrence shows an "Hours awaiting approval" chip until an admin/super
  // explicitly approves (or adjusts startedAt/completedAt back into range).
  hoursApprovedAt   DateTime?
  hoursApprovedById String?
  hoursApprovedBy   User?     @relation("HoursApprover", fields: [hoursApprovedById], references: [id], onDelete: SetNull)

  startLat    Float?
  startLng    Float?
  completeLat Float?
  completeLng Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linkedOccurrenceId String?
  linkedOccurrence   JobOccurrence?  @relation("TaskLink", fields: [linkedOccurrenceId], references: [id], onDelete: SetNull)
  linkedFromTasks    JobOccurrence[] @relation("TaskLink")

  linkGroupId String?

  // Set when admin attached a Group (crew) or the claimer claimed for a group.
  // Members are materialized into `assignees` at attach/claim time — this
  // column is the back-link so we can render "Group: Alpha (5)" and enforce
  // the group-vs-individual exclusivity rule.
  assignedGroupId String?
  assignedGroup   Group?  @relation("OccurrenceGroup", fields: [assignedGroupId], references: [id], onDelete: SetNull)

  assignees        JobOccurrenceAssignee[]
  payment          Payment?
  expenses         Expense[]
  businessExpenses BusinessExpense[]
  supplyHolds      SupplyHold[]
  addons           OccurrenceAddon[]
  instructions     OccurrenceInstruction[]
  photos           JobOccurrencePhoto[]
  propertyPhotos   OccurrencePropertyPhoto[]
  pins             PinnedOccurrence[]
  likes            LikedOccurrence[]
  reminders        Reminder[]
  comments         OccurrenceComment[]
  followupClients  FollowupClient[]
  followupJobs     FollowupJob[]
  changeRequests   OccurrenceChangeRequest[]

  @@index([linkGroupId])
  @@index([assignedGroupId])
  @@index([jobId, status])
  @@index([startAt])
  @@index([kind])
  @@index([hoursApprovedAt])
  @@index([streamResumeReminderAt])
}

model JobOccurrencePhoto {
  id String @id @default(cuid())

  occurrenceId String
  occurrence   JobOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  r2Key       String // object key in R2 bucket
  fileName    String? // original file name
  contentType String? // e.g. image/jpeg

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@index([occurrenceId])
}

model JobAssigneeDefault {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  role      String? // "observer" for observer role, null for worker
  active    Boolean @default(true)
  // Lower sortOrder = appears first. The first non-observer (sorted asc) is
  // treated as the default claimer when generating occurrences.
  sortOrder Int     @default(100)

  createdAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([jobId, active])
  @@index([userId])
}

model JobOccurrenceAssignee {
  id String @id @default(cuid())

  occurrenceId String
  occurrence   JobOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  role       String?
  assignedAt DateTime @default(now())

  assignedById String?
  assignedBy   User?   @relation("JobAssignActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([occurrenceId, userId])
  @@index([occurrenceId])
  @@index([userId])
  @@index([assignedById])
}

// PaymentMethod is no longer a DB enum — payment methods are fully
// configuration-driven via the PAYMENT_METHODS setting (a JSON taxonomy).
// Payment.method and ClientContact.preferredPaymentMethod are plain strings
// keyed to that taxonomy; writes are validated against it in payments.ts.

enum PaymentCommsMode {
  SERVER
  CLAIMER
}

model Payment {
  id String @id @default(cuid())

  // Accounting-system-agnostic ledger ID. See Checkout.ledgerId.
  ledgerId String? @unique

  // Client-facing receipt identifier. Format: "SL-XXXXXXXX" where the
  // 8-char tail is drawn from Crockford's base-32 alphabet (0-9 + A-Z
  // minus I, L, O, U — no visually/verbally ambiguous chars). Generated
  // once at Payment.create with retry-on-collision (see
  // lib/receiptNumber.ts). Immutable — appears on printed receipts,
  // client statements, and worker/admin job cards; searchable via
  // /admin/receipts/lookup.
  //
  // Non-null and unique — populated on every Payment insert. The
  // backfill migration (20260802140100_backfill_payment_receipt_number)
  // populated historical rows and flipped the column to NOT NULL in
  // one transaction, so there is no partial-state window.
  receiptNumber String @unique

  occurrenceId String        @unique
  occurrence   JobOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  amountPaid Float
  // Free string keyed to the PAYMENT_METHODS taxonomy (Settings). Validated
  // at write time against the active taxonomy — see services/payments.ts
  // loadPaymentMethodKeys(). Not a DB enum so new methods are pure config.
  method     String
  note       String?

  platformFeePercent    Float? // % charged to contractor/unclassified
  platformFeeAmount     Float? // calculated on contractor splits: (splitAmount - expenses) * percent / 100
  businessMarginPercent Float? // % retained from employee/trainee splits
  businessMarginAmount  Float? // calculated on employee/trainee splits: (splitAmount - expenses) * percent / 100

  // Nullable: client self-reports via /pay/[token] without a logged-in user;
  // claimer on-site reports set this to themselves; admin direct-records sets
  // this to the admin.
  collectedById String?
  collectedBy   User?   @relation("PaymentCollector", fields: [collectedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Approval flow:
  //   confirmed=false means the payment was reported (by client or worker)
  //   but hasn't been verified against the actual bank/account yet. The
  //   occurrence stays PENDING_PAYMENT until confirmed=true. Admin-direct
  //   records are confirmed=true at creation (admin = approver).
  confirmed     Boolean   @default(false)
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?     @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // True when the row was created via /pay/[token] client action OR a worker
  // on-site report — distinguished from an admin-direct record for audit + UI.
  selfReported  Boolean   @default(false)

  nextOccurrenceSkipReason String? // null = created successfully, "one_off" = expected, others = warning

  // Reconciliation against promisedPayouts (see JobOccurrence.promisedPayouts).
  // shortfallAmount > 0 when collected < promised: employees+trainees are
  // still paid their promised net, contractors share the shortfall pro-rata,
  // and the business absorbs the gap recorded here.
  // overageAmount  > 0 when collected > promised: workers paid promised net,
  // overage stays with the business.
  // Both are denormalized for fast reporting; never appear as a separate
  // accounting entry (cash-basis: it's already reflected in collected revenue
  // and labor cost).
  shortfallAmount Float @default(0)
  overageAmount   Float @default(0)

  // TIPS. A tip is a DESIGNATED overpayment — the operator marks part (or
  // all) of an overpayment as a tip when approving, or later via Adjust.
  //
  // `tipAmount` is the total designated; it splits into
  // `tipToBusinessAmount` plus the per-worker `PaymentSplit.tipAmount`
  // rows, which together must equal it.
  //
  // Tip and overage are MUTUALLY EXCLUSIVE: designating money as a tip
  // moves it out of `overageAmount`, which narrows to "overpayment nobody
  // called a tip". Tips bypass platform fee and business margin entirely —
  // the business's cut of a tip is exactly the percentage assigned.
  tipAmount           Float @default(0)
  tipToBusinessAmount Float @default(0)

  // Processor fees: snapshotted from the PAYMENT_METHODS taxonomy at payment
  // time so changes to the fee schedule don't rewrite history. All nullable
  // — historical rows are treated as zero-fee at read time.
  //   processorFeePercent / processorFeeFixed = rate config used
  //   processorFeeAmount  = computed dollar fee for this transaction
  //   grossCharged        = what the client paid (matches amountPaid)
  //   netReceived         = grossCharged − processorFeeAmount
  processorFeePercent Float?
  processorFeeFixed   Float?
  processorFeeAmount  Float?
  grossCharged        Float?
  netReceived         Float?

  // Admin-adjusted amount at approval time (e.g. client wrote $100 but
  // actually paid $80). adjustedFromAmount preserves the originally-reported
  // value for audit.
  adjustedAt         DateTime?
  adjustedById       String?
  adjustedBy         User?     @relation("PaymentAdjuster", fields: [adjustedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  adjustedFromAmount Float?

  // Write-off path: admin closes the books with collected=0 because client
  // never paid. Employees+trainees still get their promised net; contractors
  // get $0; full promised amount lands in shortfallAmount.
  writtenOff     Boolean   @default(false)
  writtenOffAt   DateTime?
  writtenOffById String?
  writtenOffBy   User?     @relation("PaymentWriteOff", fields: [writtenOffById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  writeOffReason String?

  // Skip path: Super pretends the service financially never happened —
  // stronger than writeOff. `writeOff` = bad debt (still counts on
  // operator dashboards, still a real transaction). `skippedAt` =
  // erase from every aggregate. Every money query (income, exports,
  // payroll, 1099s, P&L, vs-revenue, accounting) filters
  // `skippedAt IS NULL`. Payment splits stay on the row for audit
  // history but are excluded from all payroll/1099 aggregations.
  // Gated to Super-only + type-APPROVE at the mutation layer.
  skippedAt   DateTime?
  skippedById String?
  skippedBy   User?     @relation("PaymentSkip", fields: [skippedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  skipReason  String?

  splits PaymentSplit[]

  createdAt DateTime @default(now())

  @@index([collectedById, createdAt])
  @@index([method, createdAt])
  @@index([confirmed, createdAt])
  @@index([writtenOff, createdAt])
  @@index([skippedAt, createdAt])
  @@index([processorFeeAmount, createdAt])
}

model PaymentSplit {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // `amount` is the worker's final net payout (gross − fee + topUp).
  // The breakdown columns below are populated for transparency/reporting:
  //   grossAmount  = N × splitPercent  (worker's share before fee)
  //   ratePercent  = the fee/margin rate applied to THIS worker
  //   feeAmount    = grossAmount × ratePercent / 100
  //   netAmount    = grossAmount − feeAmount  (pre-topUp)
  //   topUpAmount  = extra the business paid out to make an employee/trainee
  //                  whole when the client underpaid
  // All nullable on historical rows; populated on rows created after the
  // 20260518_payment_reconciliation migration.
  amount      Float
  grossAmount Float?
  ratePercent Float?
  feeAmount   Float?
  netAmount   Float?
  topUpAmount Float  @default(0)

  // Stamped at write time when the split's user is the LLC owner. Excluded
  // from Gusto/payroll exports — the owner takes a draw, not a paycheck.
  ownerEarnings Boolean @default(false)

  // This worker's share of the payment's tip. Deliberately a SEPARATE
  // column from `amount`, not folded into it: every existing reader of
  // `amount` (payroll netPaid, QB income, workdays CSV, 1099 aggregation,
  // worker earnings) would otherwise absorb tips silently AND mis-anchor
  // them — job pay is WORK-anchored (JobOccurrence.completedAt) while a
  // tip is PAYMENT-anchored (Payment.confirmedAt), because a tip doesn't
  // exist until the client pays it. A worker can legitimately receive the
  // job payout on one payroll and the tip on another.
  tipAmount Float @default(0)

  createdAt DateTime @default(now())

  @@unique([paymentId, userId])
  @@index([userId, createdAt])
  @@index([ownerEarnings, createdAt])
}

model Expense {
  id String @id @default(cuid())

  occurrenceId String
  occurrence   JobOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  cost        Float
  description String

  // 1:1 link to the BusinessExpense (tax ledger) row. Every Expense added on
  // a job in MVP-step-2 onward gets a paired BusinessExpense — workers buy on
  // the company card, so per-job spend IS a business expense.
  businessExpenseId String?          @unique
  businessExpense   BusinessExpense? @relation(fields: [businessExpenseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Back-relation: when this Expense was created by consuming inventory
  // (MVP-step-3), the SupplyHold owns the link via SupplyHold.expenseId.
  // No BusinessExpense is paired in this case — the BE was already recorded
  // at purchase time, and double-recording would inflate tax-ledger totals.
  supplyHold SupplyHold?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([occurrenceId])
  @@index([createdById])
}

// BusinessExpense is the canonical Accounting ledger row. Despite the name,
// it now stores three KINDS of money entries — discriminated by `type`:
//   EXPENSE              — operating cash-out (default; backward-compat)
//   CAPITAL_CONTRIBUTION — owner money INTO the business (equity)
//   OWNER_DRAW           — owner money OUT of the business (equity)
//
// All three share the same shape (date, amount, vendor, description,
// receipt, recurrence) so the UI, receipt anchor, and recurrence engine
// work identically for all of them. Surfaces that semantically mean
// "expenses only" must filter `type = EXPENSE` explicitly:
//   - vs-revenue (P&L)
//   - summary
//   - qbExpensesCsv (QB import — Schedule C lines)
//   - Schedule C CSV export
// Surfaces that span all types (full bookkeeping list, due-soon recurrence
// suggestions, receipt routes) do NOT filter by type.
//
// Three creation paths, all land here regardless of type:
//   1. Freestanding — admin types into Add Entry. The Type picker chooses
//      EXPENSE / CAPITAL_CONTRIBUTION / OWNER_DRAW.
//   2. Job-paired — worker logs an Expense on a JobOccurrence (always
//      EXPENSE). Linked via Expense.businessExpenseId.
//   3. Supply-paired — SupplyPurchase creates a BE at buy time (always
//      EXPENSE). Linked via SupplyPurchase.businessExpenseId.
//
// Export shape:
//   - Schedule C CSV (Accounting tab "Export" button) — EXPENSE only, line
//     numbers from EXPENSE_CATEGORIES taxonomy.
//   - qb-expenses.csv (Exports tab) — EXPENSE + processor fees.
//   - qb-equity.csv (Exports tab) — CAPITAL_CONTRIBUTION + OWNER_DRAW with
//     standard equity account names ("Owner's Investment" / "Owner's Draw").
//
// Tax-export integrity: only raw cash-flow fields (cost, date, vendor) flow
// into any export — no derived margin/shortfall fields ever appear.
model BusinessExpense {
  id String @id @default(cuid())

  // Accounting-system-agnostic ledger ID. See Checkout.ledgerId.
  // One ledgerId covers EXPENSE, OWNER_DRAW, and CAPITAL_CONTRIBUTION
  // uniformly — the type discriminator routes which QB export the row
  // ends up in, but the ID format is identical.
  ledgerId String? @unique

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Discriminator. Default is EXPENSE so existing rows keep their meaning;
  // see EntryType enum doc for the full picture.
  type EntryType @default(EXPENSE)

  date          DateTime
  cost          Float
  description   String
  // Schedule C category — meaningful only for type = EXPENSE. For
  // CAPITAL_CONTRIBUTION / OWNER_DRAW this stays null (those are equity
  // accounts, not Schedule C lines).
  category      String?
  vendor        String?
  invoiceNumber String?
  notes         String?
  // Free-text record of which account / instrument the payment came from
  // (e.g. "Chase business card", "Owner cash", "Bluevine checking"). Pure
  // operator note — not categorized, never feeds tax line items. Useful for
  // reconciling against bank/card statements at month-end.
  paymentFrom   String?

  // Optional link to a piece of equipment — useful for capital purchases
  // (e.g. "$8K rider mower" categorized as Depreciation gets linked to its
  // Equipment row so we can track per-equipment lifetime cost later).
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Optional link to a job occurrence — set when the expense was incurred for
  // a specific job (worker buys gas on the company card). The corresponding
  // per-Job Expense row drives payout reduction; this row is the tax ledger
  // entry. Linked 1:1 via Expense.businessExpenseId.
  occurrenceId String?
  occurrence   JobOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  expense      Expense?

  // Back-relation: when this BE was created by an inventory purchase
  // (MVP-step-3), the SupplyPurchase owns the link via
  // SupplyPurchase.businessExpenseId. Allows the tax-ledger UI to surface a
  // "Supply: Mulch ×10" badge and link back to the Supplies tab.
  supplyPurchase SupplyPurchase?

  // Optional receipt photo. Stored in the seedlings-receipts R2 bucket; the
  // R2 key is the canonical reference. Same anchor for all 3 expense
  // sources (freestanding BE, job-Expense pair, supply-purchase pair).
  receiptR2Key       String?
  receiptFileName    String?
  receiptContentType String?
  receiptUploadedAt  DateTime?

  // Optional cadence flag for recurring expenses (e.g. monthly software
  // subscriptions). Null = one-off. Series identity is tracked by the
  // `recurrenceSeriesId` field below — all rows in the same series share
  // an id, which is what drives "due to record" grouping. Legacy rows
  // predating the series-id migration may have a null id; the
  // /business-expenses/due-soon endpoint falls back to the old
  // (type, description, vendor) key for those.
  recurrence ExpenseRecurrence?

  // Explicit series identifier. All rows in the same recurring series
  // share this value — mint a fresh id when a NEW recurring expense is
  // added, copy the source row's id when a subsequent instance is
  // recorded via the "Record" flow on the Due-to-record panel. This
  // replaces the previous implicit series key of
  // (type, description, vendor), which forked whenever the label text
  // drifted (typo, autocorrect, hidden character). See Vercel incident
  // 2026-07-13 for the motivating bug.
  recurrenceSeriesId String?

  // When set, the next-expected date for the series is computed from this
  // date instead of `date + cadence`. Used by the "Skip" button on the Due
  // to record panel: skipping the May invoice sets this to the May expected
  // date, so the next suggestion is one cadence later.
  recurrenceSkippedUntil DateTime?

  // "Ended series" flag — set when the operator explicitly ends a
  // recurring series (via the "End series" button on the Due-to-record
  // panel). Applied to the LATEST row in the series (highest `date`).
  // While set, the series drops out of the Due-to-record panel, its
  // alert count, and the continuation-matcher hint.
  //
  // Historical rows in the series stay untouched — full audit trail
  // preserved. The series can be restarted at any time from the ended
  // row's Edit dialog (clears both fields), or auto-resumes when a
  // fresh row is recorded (new row becomes latest, its flag is null).
  //
  // Distinct from `recurrenceSkippedUntil` (skip ONE cycle, series
  // continues) and from `recurrence = null` (row was never recurring
  // to begin with).
  recurrenceEndedAt   DateTime?
  recurrenceEndedById String?
  recurrenceEndedBy   User?     @relation("BusinessExpenseSeriesEnder", fields: [recurrenceEndedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Reconciliation flag — set when the operator has manually matched
  // this entry against QuickBooks (or another external source of
  // truth) and confirmed the two agree. Null = not yet reconciled.
  // Filterable on the Super → Money → Ledger tab so the operator can
  // see their outstanding work queue.
  //
  // Applies to ALL entry types (EXPENSE, CAPITAL_CONTRIBUTION,
  // OWNER_DRAW) — reconciliation is a bookkeeping concept, not a
  // Schedule-C concept, so equity entries are in scope too.
  //
  // Historical rows created before this feature shipped stay null
  // (unreconciled) by design — see the migration note.
  reconciledAt   DateTime?
  reconciledById String?
  reconciledBy   User?     @relation("BusinessExpenseReconciler", fields: [reconciledById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([createdById])
  @@index([equipmentId])
  @@index([occurrenceId])
  @@index([type])
  @@index([recurrenceSeriesId])
  @@index([reconciledAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  // Presentational grouping for the Settings tab. A free string key; section
  // titles/descriptions/order live in a web-side code constant. Null or an
  // unknown value falls into the "Other" group in the UI.
  section     String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────────────────────────────────────────
// Promotions — Super-only marketing campaigns that piggyback on outgoing
// invoice communications and/or display passively on the /pay/[token]
// invoice page. Design goals:
//   • Piggyback (no separate scheduler needed for MVP-1)
//   • Extensible: audienceSpec / triggerConfig / channels are JSON so
//     future triggers (cron, on_receipt_sent) don't force migrations.
//   • Auditable: every state transition + every delivery attempt is
//     preserved. contentSnapshot on the delivery row captures the exact
//     body sent, so paused-edited-resumed campaigns can be audited
//     accurately per recipient.
// See services/promotions.ts for the full policy: cooldown, multi-promo
// tie-breakers per channel, opt-out gating, CAN-SPAM footer assembly.
// ─────────────────────────────────────────────────────────────────────────────

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

// EXTERNAL  → Promotion.link is a fully-qualified URL the operator typed
// LANDING_PAGE → Promotion.landingPageId points at an in-app landing page
//                that we render at /promotion/<slug>. The resolver picks
//                the right destination at runtime; the rest of the
//                pipeline just sees a URL.
enum PromotionLinkKind {
  EXTERNAL
  LANDING_PAGE
}

model Promotion {
  id          String @id @default(cuid())
  title       String
  description String @db.Text

  // Canonical destination for the promo's CTA. Single URL, per-channel
  // CTA text is defined inside `content`.
  //
  // Two modes, selected by `linkKind`:
  //   EXTERNAL     → `link` holds the operator-typed URL.
  //   LANDING_PAGE → `landingPageId` points at an in-app landing page,
  //                  rendered at /promotion/<slug>. `link` is left null.
  // Runtime resolver in services/promotions.ts picks the right destination.
  linkKind      PromotionLinkKind     @default(EXTERNAL)
  link          String?
  landingPageId String?               @unique
  // Restrict (not SetNull) so a Promotion referencing a LandingPage
  // can't have its FK silently nulled while linkKind stays LANDING_PAGE
  // (ghost state → resolveDestinationUrl returns null → click 302s to
  // bare baseUrl). Any code that wants to delete a landing page MUST
  // first flip the parent promotion's linkKind back to EXTERNAL (and
  // clear landingPageId) inside the same transaction, or the DELETE
  // fails loudly rather than corrupting audit-observable state.
  landingPage   PromotionLandingPage? @relation(fields: [landingPageId], references: [id], onDelete: Restrict)

  // Audience selector — MVP: { kind: "all" }. Future: segments, explicit
  // clientId lists, etc.
  audienceSpec Json @default("{\"kind\":\"all\"}")

  // Dispatch (push) channels — subset of ["email", "sms"]. Opt-out gated.
  // Requires triggerKind non-null when non-empty.
  dispatchChannels Json @default("[]")

  // Display surfaces — subset of ["invoice_page"]. NOT opt-out gated
  // (passive display; client is already on the page they chose to open).
  // Always active during startAt..endAt window.
  displaySurfaces Json @default("[]")

  // Trigger for dispatch channels. MVP values: "on_invoice_sent",
  // "manual_send". Nullable when the promotion targets only display
  // surfaces (no dispatch → no trigger needed).
  triggerKind   String?
  triggerConfig Json    @default("{}")

  // Reserved for phase-2 discount/offer mechanics. UI shows the field
  // disabled with "TBD" copy today. Included from the start so the
  // eventual migration is just data, not schema.
  offer Json?

  // Cooldown window (days) — a single (promotionId, contactId) tuple
  // will not be attached to more than one outbound message within this
  // many days. Applies to dispatch channels only; invoice_page always
  // renders during the promotion window.
  cooldownDays Int @default(7)

  startAt DateTime?
  endAt   DateTime?

  status PromotionStatus @default(DRAFT)

  // Offer content (validated at the service layer via Zod — this is a Json
  // column, so Postgres enforces nothing about its shape).
  //
  // Expected shape:
  //   { shared:       { headline?, body, ctaText },   ← the canonical copy
  //     sms:          { body, ctaText },              ← optional override
  //     email:        { subject, body, ctaText },     ← optional override
  //     invoice_page: { headline?, body, ctaText } }  ← optional override
  //
  // `shared` is what the operator writes once; every channel and display
  // surface inherits it. The per-channel keys exist ONLY when that channel
  // was deliberately customized (SMS is the usual case — 160 characters
  // wants its own wording). Resolve via resolveChannelContent() in
  // services/promotions.ts — never read a channel key directly, or the
  // surface will disagree with what the operator previewed.
  //
  // body is Markdown for email + invoice_page + shared; plain text for sms.
  //
  // NOTE: rows created before the 2026-08-22 copy collapse have no
  // `shared` key. resolveChannelContent falls back to the per-channel
  // content, and the landing page falls back to its own headline/intro
  // columns, so those promotions keep rendering. There was no migration
  // because Json needs none — which also means there was no backfill.
  content Json @default("{}")

  // Lock preventing overlapping manual_send bursts. Set when the burst
  // starts, cleared when it finishes (or times out after 5 minutes).
  lastDispatchStartedAt DateTime?

  // Short URL slug — the branded segment of the promo click wrapper URL.
  // When set: outbound URLs are `<baseDomain>/mo/<shortSlug>/<code>` for
  // per-recipient tracking and `<baseDomain>/mo/<shortSlug>` for
  // anonymous sharing (lawn signs / social). When null: the older long
  // wrapper (`/api/public/promotion/click/d/<id>?t=<hmac>`) is used
  // instead. This gives operators an opt-in migration path — existing
  // campaigns keep working, new ones can adopt the branded shape.
  //
  // Locked once status transitions out of DRAFT (same lock semantics
  // as PromotionLandingPage.slug). Kebab-case + digits, ≤40 chars,
  // enforced at the service layer.
  shortSlug String? @unique

  // Per-campaign domain override for outbound URLs. When set, must be
  // a member of the ALLOWED_DOMAINS setting. When null, falls through
  // to the PAYMENT_REQUEST_BASE_URL primary. Feeds both the short URL
  // builder and the (existing) long wrapper URL builder.
  baseDomain String?

  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation("PromotionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   User?     @relation("PromotionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  startedAt   DateTime?
  startedById String?
  startedBy   User?     @relation("PromotionStarter", fields: [startedById], references: [id], onDelete: SetNull)
  closedAt    DateTime?
  closedById  String?
  closedBy    User?     @relation("PromotionCloser", fields: [closedById], references: [id], onDelete: SetNull)

  deliveries PromotionDelivery[]
  clicks     PromotionClick[]

  // Photos shown with this promo on the invoice page. Deliberately hung
  // off Promotion, NOT off the landing page: an EXTERNAL-link promo has
  // no landing page at all, yet can still target invoice_page — under the
  // old "first photo of the first landing item" rule those promos could
  // never show an image. See PromotionInvoicePhoto.
  invoicePhotos PromotionInvoicePhoto[]

  @@index([status])
  @@index([triggerKind, status])
}

// One photo shown alongside a promotion on the client's invoice page.
//
// WHY THIS EXISTS SEPARATELY FROM PromotionLandingPageItemPhoto:
// the invoice cover used to be derived — "first photo of the first
// landing-page item". That coupled two unrelated surfaces: reordering
// landing items, or deleting an item's first photo, silently changed
// what every client saw on their invoice. It also left EXTERNAL-link
// promos (no landing page) with no image possible at all.
//
// Invoice photos are now uploaded independently and are the ONLY source
// for the invoice surface. Landing items keep their own photos for the
// landing page; neither reads the other.
//
// Shape mirrors PromotionLandingPageItemPhoto (r2Key + contentType +
// sortOrder) so the presign → confirm → delete → reorder flow is the
// same one used by every other photo surface in the app.
model PromotionInvoicePhoto {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  // R2 storage key in the promotion-images bucket. Any aspect ratio is
  // accepted; the invoice square-crops the cover at render time.
  r2Key       String
  contentType String?

  // Display order — lower first. sortOrder 0 is the cover rendered beside
  // the promo text; the rest appear in a strip beneath it.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([promotionId, sortOrder])
}

model PromotionDelivery {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  // Both FKs are nullable + SetNull so deleting a Client or ClientContact
  // is never blocked by promotion history. The delivery row survives
  // with a null FK (contentSnapshot + timestamps preserved), matching
  // the audit-first pattern used for User actor refs across the schema.
  // Trade-off: after deletion, "who was this sent to?" reads as
  // "(deleted contact)" in the delivery log — acceptable since the
  // promo body is already snapshotted on the row itself.
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contactId String?
  contact   ClientContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // "email" | "sms" | "invoice_page"
  channel String

  // Free-form reference tag for the triggering event. Populated with
  // paymentRequestId for on_invoice_sent; null for manual_send.
  triggeredBy String?

  // Set to a random UUID per invocation of "Send Now" so the audit log
  // can group everyone who got a given manual burst together. Null for
  // piggyback deliveries (each has its own triggeredBy).
  dispatchId String?

  // Snapshot of the exact body/subject/ctaText that shipped. Preserves
  // "what did this contact actually see?" even after later edits to the
  // parent Promotion. Shape mirrors Promotion.content[channel].
  contentSnapshot Json

  // Deferred-scheduler hook. Piggyback writes null; a future scheduler
  // will queue rows with scheduledFor set and stamp deliveredAt when
  // the worker picks them up. No cron reads this today.
  scheduledFor DateTime?

  // One of these is populated per row:
  //   • deliveredAt non-null, skippedReason null   → shipped
  //   • deliveredAt null,     skippedReason non-null → skipped (see reason)
  //   • both null                                    → scheduled/pending
  deliveredAt   DateTime?
  skippedReason String?

  createdAt DateTime @default(now())

  // Click-back link — set when a PromotionClick row (from the wrapper
  // redirect endpoint) can be tied to a specific delivery via its HMAC
  // token. Purely optional; forwarded/anonymous clicks leave this null.
  clicks PromotionClick[]

  // Short URL per-recipient code — the last segment of the branded
  // wrapper URL `<baseDomain>/mo/<shortSlug>/<code>`. 4 lowercase
  // alphanumeric chars, generated per delivery with collision retry.
  // Unique per promotion (a code can be reused across promotions
  // — the URL prefix disambiguates). Nullable so existing deliveries
  // without a shortCode fall back to the long-form wrapper.
  shortCode String?

  // Reporting indexes intentionally deferred until PromotionDelivery
  // grows past ~10k rows (see MVP-1 spec). Add:
  //   @@index([promotionId, contactId, createdAt])  ← cooldown lookup
  //   @@index([clientId, createdAt])                ← per-client history

  // Enforces "code unique within a campaign" — a click to
  // /mo/<slug>/<code> resolves to exactly one delivery. Compound so
  // different campaigns can share the same code (e.g. "abcd") without
  // collision, keeping the code space per-promotion at ~1.7M
  // combinations rather than a shared global namespace.
  @@unique([promotionId, shortCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// PromotionLandingPage — the in-app landing page shown when a Promotion's
// linkKind is LANDING_PAGE. Public URL is /promotion/<slug>. Auto-slugged
// from title on create; Super can override while DRAFT; locked once ACTIVE
// so already-shipped SMS/email links don't go dead.
// ─────────────────────────────────────────────────────────────────────────────
model PromotionLandingPage {
  id   String @id @default(cuid())
  slug String @unique

  // Optional heading + intro paragraph rendered above the item grid.
  // Both Markdown-safe on the page but expected to be short.
  headline String?
  intro    String? @db.Text

  // Bumped once per page render — a lightweight impression counter
  // separate from PromotionClick (which measures "someone tapped the
  // CTA"). Diverges when links are forwarded or the page is reloaded.
  viewCount Int @default(0)

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("PromotionLandingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("PromotionLandingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  items     PromotionLandingPageItem[]
  // Back-relation from Promotion.landingPageId. 1:1 — a landing page
  // belongs to exactly one Promotion, and vice versa.
  promotion Promotion?
}

model PromotionLandingPageItem {
  id     String               @id @default(cuid())
  pageId String
  page   PromotionLandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  title       String
  description String @db.Text // Markdown

  // DEPRECATED — superseded by the `photos` relation below, which
  // supports multiple images per item. Retained (not dropped) so the
  // backfill in migration `add_landing_item_photos` stays auditable and
  // a rollback doesn't lose the original key. Nothing reads these two
  // columns any more; new writes go to PromotionLandingPageItemPhoto.
  imageR2Key    String?
  imageMimeType String?

  photos PromotionLandingPageItemPhoto[]

  // Display order — lower first. Editor drag-reorders update this.
  ordinal Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, ordinal])
}

// One photo on a landing-page item. Mirrors the PropertyPhoto shape
// (r2Key + contentType + sortOrder) so the upload/confirm/delete flow
// matches every other photo surface in the app.
model PromotionLandingPageItemPhoto {
  id     String                   @id @default(cuid())
  itemId String
  item   PromotionLandingPageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // R2 storage key in the promotion-images bucket. Any aspect ratio is
  // accepted; the grid square-crops at render time via CSS.
  r2Key       String
  contentType String?

  // Display order within the item — lower first. The first photo is the
  // one used for link previews (og:image).
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([itemId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// PromotionClick — one row per tap on a promotion CTA URL. Written by
// the wrapper redirect endpoint /promotion/click/<deliveryId>?t=<hmac>.
// Every CTA embedded in an SMS / email / invoice-page button is a
// wrapper URL, not the raw destination — the wrapper logs then 302s.
//
// Anonymous rows (forwarded SMS, shared URL, invalid/missing HMAC) leave
// deliveryId / contactId / clientId null. `reason` explains why.
// ─────────────────────────────────────────────────────────────────────────────
model PromotionClick {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  // Delivery + contact context resolved from the HMAC token, when valid.
  // All three cleared on delete of the parent (SetNull) — click history
  // persists indefinitely even if the recipient is later removed.
  deliveryId String?
  delivery   PromotionDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  contactId  String?
  contact    ClientContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  clientId   String?
  client     Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // "external" | "landing_page" — where the redirect went. Kept even if
  // the promotion later flips linkKind so historical clicks stay honest.
  destination    String
  destinationUrl String // Snapshot of the URL the redirect resolved to

  // Why the click resolved as anonymous, when contactId is null.
  //   "forwarded_or_manual_share" — token missing or unverifiable
  //   "delivery_not_found"        — token verifies but delivery row was deleted
  //   null                        — recipient was resolved
  anonymousReason String?

  // Lightweight fingerprints. ipHash is sha256(ip) for privacy — we can
  // dedupe multi-clicks from the same person without storing the raw IP.
  userAgent String? @db.Text
  ipHash    String?

  createdAt DateTime @default(now())

  @@index([promotionId, createdAt])
  @@index([contactId, createdAt])
  @@index([deliveryId])
}

model PinnedOccurrence {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  occurrenceId String
  occurrence   JobOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

