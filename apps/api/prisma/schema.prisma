model Client {
  id          String     @id @default(cuid())
  type        ClientType
  displayName String

  status ClientStatus @default(ACTIVE)

  isVip     Boolean @default(false)
  vipReason String?

  notesInternal String?
  adminTags     String? // JSON string array e.g. ["LATE_PAYER","ARGUMENTATIVE"] — admin-only

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  //TODO: NOT BEING USED YET, BUT SHOULD MAKE ALL ENTITIES BE RETIRED/ARCHIVED
  archivedAt DateTime?

  // Relations
  contacts   ClientContact[]
  properties Property[]
  jobClients JobClient[]
  followups  FollowupClient[]

  promotionDeliveries PromotionDelivery[]
  promotionClicks     PromotionClick[]

  @@index([status])
  @@index([displayName])
}

model ClientContact {
  id String @id @default(cuid())

  status ContactStatus @default(ACTIVE)

  // Belongs to Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Identity
  firstName       String
  lastName        String
  nickname        String?
  email           String?
  phone           String? // raw as entered
  normalizedPhone String? @db.VarChar(20) // E.164 for dedupe/lookup

  role      ContactRole?
  isPrimary Boolean      @default(false)

  // The Clerk identity that this contact record is bound to (set at
  // signup-time via /client/link or at contact-create-time when an
  // existing match already has one). NOT unique: a single Clerk user
  // can be bound to multiple ClientContact records when the same
  // person appears as a contact across multiple Clients (e.g., a
  // person who pays for a rental AND has the company service their
  // own home). All matching rows get updated together at link-time.
  clerkUserId String?

  // Nullable forward-compat hook. When/if we ever promote contact
  // identity to a first-class `Person` table, we'll populate this
  // FK; for now it stays null. The column existing lets that
  // migration be additive instead of requiring a schema change on
  // a large table later.
  personId String?

  // Auto-learned from each approved payment — used to pre-select the method
  // in the worker's Record Payment dialog and to highlight the same method
  // first on the public /pay/[token] page.
  // Stored as a free string keyed to the PAYMENT_METHODS taxonomy (Settings).
  preferredPaymentMethod String?

  // Set when this contact signs up for an account via the post-payment
  // nudge on /pay/[token]. Drives future discount/credit logic — kept now
  // so we can apply retroactive credits when that feature ships.
  clientAccountCreatedFromPaymentPageAt DateTime?

  // Promotional-message opt-out flags — per-channel because a contact
  // can have both email and SMS on file and opt out of one without the
  // other. Default false = opted-in. NEVER checked for transactional
  // messages (invoices, receipts, appointment confirms) — only promo
  // piggybacks and manual-send blasts consult these flags.
  //
  // Set by:
  //   • the client, via a signed HMAC opt-out URL in the promo footer
  //   • the client, via the "Opt in to promotion offers" affordance on
  //     the /pay/[token] page
  //   • a Super, via the Promotions tab (opt-in requires typed APPROVE
  //     and a documented reason, per CAN-SPAM defensive posture)
  //   • the Resend hard-bounce webhook (phase 2) → auto-opt-out for
  //     email with source="hard_bounce"
  //
  // Every flip writes an AuditEvent { scope: PROMO_OPT, verb: PROMO_OPTED_OUT|IN,
  //   metadata: { source, channel, reason? } } so the reason for each
  //   change is preserved for CAN-SPAM compliance.
  promoEmailOptedOut Boolean @default(false)
  promoSmsOptedOut   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertiesAsPOC Property[] @relation("PropertyPOC")

  // Backref from Property.pointOfContactId targets this model

  jobContacts         JobContact[]
  promotionDeliveries PromotionDelivery[]
  promotionClicks     PromotionClick[]

  // Email, normalizedPhone, and clerkUserId are intentionally NOT
  // globally unique. A single person can appear as a contact across
  // multiple Clients (e.g., the person who pays for a rental AND
  // has us service their own home). All matching rows can share
  // identity fields AND a Clerk binding. Identity drift between
  // rows is prevented at the UX layer:
  //   • On create: the admin dialog runs a pre-flight lookup by
  //     phone/email and surfaces matches, requiring an explicit
  //     "yes, add anyway" before writing.
  //   • On edit: the dialog detects linked rows (same clerkUserId
  //     or same identity) and offers to propagate changes.
  // The Clerk auto-link in /client/link finds ALL matching contacts
  // by email and updates them together, not just the first.
  // findMany / updateMany are the canonical access patterns for
  // these fields; findUnique on any of them is a bug.
  @@index([email])
  @@index([normalizedPhone])
  @@index([clerkUserId])
  @@index([personId])
  @@index([clientId, status])
}

model Property {
  id String @id @default(cuid())

  // Belongs to Client
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  kind PropertyKind @default(SINGLE)

  // Labels & addressing
  displayName String
  street1     String
  street2     String?
  city        String
  state       String
  postalCode  String
  country     String

  // Optional geo — populated by the parcel lookup (services/parcels.ts),
  // NOT by hand. The address is geocoded once and the result cached here.
  lat Float?
  lng Float?
  //geohash            String

  // ── Public parcel record (county assessor via NC OneMap) ────────────────
  //
  // Cached because a parcel boundary changes at most once a year, while a
  // job card can be opened dozens of times a day. Re-resolved when
  // `parcelFetchedAt` is older than the configured cache window.
  //
  // `parcelData` holds the assessor attributes (acreage, land/improvement
  // value, owner of record, county) and `parcelBoundary` the polygon rings
  // in EPSG:4326 — kept separate because the boundary is ~30x larger and is
  // only needed when drawing the map.
  parcelData        Json?
  parcelBoundary    Json?
  parcelFetchedAt   DateTime?
  /// R2 key for the cached overhead image, in the property-photos bucket
  /// under a `parcel/` prefix. Null until someone opens the map.
  parcelImageKey    String?
  parcelImageAt     DateTime?
  /// The geographic extent + pixel size the cached image was rendered at, so
  /// the parcel boundary can be drawn over it without re-deriving the bbox.
  parcelImageBox    Json?
  /// Set when a lookup ran but found nothing — an out-of-state property, or
  /// an address the geocoder can't place. Stops us retrying on every open;
  /// cleared by a forced refresh.
  parcelLookupError String?

  // Aggregate-site (community) fields (optional)
  //unitLabel          String?        // e.g., "home", "lot", "unit"
  //unitCount          Int?
  //siteName           String?
  //siteBoundaryGeo    Json?          // polygon/bbox later if needed

  // Default point of contact for this property
  pointOfContactId String?
  pointOfContact   ClientContact? @relation("PropertyPOC", fields: [pointOfContactId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Property size
  lotSize     Float?
  lotSizeUnit String? // e.g. "sqft", "acres", "hectares"

  // Light ops
  accessNotes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  status PropertyStatus @default(ACTIVE)

  jobs   Job[]
  photos PropertyPhoto[]

  @@index([clientId])
  @@index([kind])
}

