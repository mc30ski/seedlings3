  text         String
  isPreset     Boolean       @default(false)
  repeats      Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())

  @@index([occurrenceId])
}

// ── Client-initiated change requests on a scheduled occurrence ──────────────
// Clients can request a reschedule (with proposed date) or skip a single
// occurrence. Admins approve/deny — approval applies the change.
enum ChangeRequestKind {
  RESCHEDULE
  SKIP
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELED
}

model OccurrenceChangeRequest {
  id              String              @id @default(cuid())
  occurrenceId    String
  occurrence      JobOccurrence       @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  requestedById   String
  requestedBy     User                @relation("ChangeRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  kind            ChangeRequestKind
  status          ChangeRequestStatus @default(PENDING)
  proposedStartAt DateTime?
  comment         String?
  resolvedById    String?
  resolvedBy      User?               @relation("ChangeRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([occurrenceId])
  @@index([requestedById])
  @@index([status])
}

// ── Supplies (MVP-step-3) ─────────────────────────────────────────────────────
//
// Inventory-tracked consumables. Decoupled from job-Expense so we can record
// the tax deduction at PURCHASE time (cash-method accounting) but charge the
// payout deduction at CONSUMPTION time, with optional markup.
//
//   Supply           = catalog row (one per SKU), tracks onHand
//   SupplyPurchase   = a buy event, paired 1:1 with a BusinessExpense (tax)
//   SupplyHold       = a consumption against an occurrence; ACTIVE reserves
//                      units, CONSUMED draws them down on completion
//   SupplyAdjustment = manual count corrections (no tax effect)

model Supply {
  id String @id @default(cuid())

  name          String
  description   String?
  unit          String // "bag", "spool", "lb"
  // For future UPC-scan add-flow. Nullable; not unique because the same
  // SKU could legitimately be entered twice with different display names.
  upc           String?
  // Schedule C category for the BusinessExpense paired with each purchase.
  // Defaults to "Supplies"; can be overridden per supply (e.g. "Car and
  // truck expenses" if you ever want to track fuel as inventory).
  category      String  @default("Supplies")
  // Reference businessCost — typically updated to the most recent
  // SupplyPurchase.unitCost. Display-only / default for new purchases.
  businessCost  Float   @default(0)
  // Per-unit charge to the job's payout when consumed. May exceed
  // businessCost — the difference is implicit business margin (similar to
  // platform fee / employee margin). Snapshot at hold time so retroactive
  // edits don't reprice existing holds.
  jobPayoutCost Float   @default(0)
  // Physical units in stock. Available = onHand − Σ(active holds), computed
  // at query time.
  onHand        Int     @default(0)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  purchases   SupplyPurchase[]
  holds       SupplyHold[]
  adjustments SupplyAdjustment[]

  @@index([archivedAt])
  @@index([upc])
  @@index([name])
}

model SupplyPurchase {
  id String @id @default(cuid())

  supplyId String
  supply   Supply @relation(fields: [supplyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  quantity      Int
  unitCost      Float // per-unit cost at this purchase (snapshot)
  totalCost     Float // quantity × unitCost (denormalized for export)
  date          DateTime @default(now())
  vendor        String?
  invoiceNumber String?
  notes         String?

  // 1:1 link to the tax-ledger row created at the same time. Same dual-write
  // pattern as job Expense ↔ BusinessExpense in step-2. Restrict (not
  // Cascade): deleting the BE while a SupplyPurchase is linked would orphan
  // inventory; the BE-delete handler must reverse inventory and remove the
  // SupplyPurchase first.
  businessExpenseId String          @unique
  businessExpense   BusinessExpense @relation(fields: [businessExpenseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplyId, date])
  @@index([date])
}

model SupplyHold {
  id String @id @default(cuid())

  supplyId String
  supply   Supply @relation(fields: [supplyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  occurrenceId String
  occurrence   JobOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  quantity      Int
  jobPayoutCost Float // per-unit charge snapshot at hold time
  status        SupplyHoldStatus @default(ACTIVE)

  // 1:1 link to the per-job Expense row that drives payout deduction.
  // No paired BusinessExpense — the BE was created at purchase time;
  // recording another at consumption would double-count for taxes.
  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  consumedAt  DateTime?
  releasedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([supplyId, status])
  @@index([occurrenceId])
  @@index([status])
}

model SupplyAdjustment {
  id String @id @default(cuid())

  supplyId String
  supply   Supply @relation(fields: [supplyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  delta  Int // +N or −N units
  reason String

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([supplyId, createdAt])
}

enum SupplyHoldStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum ExpenseRecurrence {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

// EntryType discriminates the BusinessExpense table into the three kinds of
// "money out / money in" the Accounting tab tracks. All three land in the
// same table so receipt upload, recurrence, filters, and editing UI work
// identically; surfaces that mean "expenses only" (Schedule C export,
// vs-revenue P&L, qb-expenses CSV, summary) filter explicitly on
// type = EXPENSE. CAPITAL_CONTRIBUTION and OWNER_DRAW flow to QuickBooks via
// the equity export under standard sole-prop equity account names.
enum EntryType {
  EXPENSE
  CAPITAL_CONTRIBUTION
  OWNER_DRAW
}

// ─────────────────────────────────────────────────────────────────────────────
// Groups (crews)
//
// A Group is a saved roster of workers + observers led by a single claimer.
// Admins manage groups via Admin → Directory → Groups. A user can be in
// multiple groups. At job-assignment time the group is *materialized* into
// individual JobOccurrenceAssignee rows — the group is a template, not a
// live join. Mid-flight group edits never propagate to in-flight occurrences;
// see the lock check in services/groups.ts.
// ─────────────────────────────────────────────────────────────────────────────
model Group {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text

  claimerUserId String
  claimer       User   @relation("GroupClaimer", fields: [claimerUserId], references: [id], onDelete: Restrict)

  members            GroupMember[]
  preferredEquipment GroupPreferredEquipment[]

  // Back-relations
  occurrences    JobOccurrence[] @relation("OccurrenceGroup")
  checkouts      Checkout[]
  defaultForJobs Job[]           @relation("JobDefaultGroup")

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([claimerUserId])
  @@index([archivedAt])
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // "worker" (null in JobOccurrenceAssignee terms) or "observer"
  role String @default("worker")

  // Per-member share of group equipment costs. Null = even-split among
  // workers (observers always excluded). When any are non-null, every worker
  // in the group must have a value and they must sum to exactly 100.
  equipmentCostPercent Float?

  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

// Preferred equipment + collections for a group. Display-only — never
// auto-reserves. Surfaces as a "Group preferred" panel on occurrences
// claimed by the group. Exactly one of equipmentId / equipmentCollectionId
// must be set (enforced in app code; no Prisma CHECK constraint).
model GroupPreferredEquipment {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  equipmentId           String?
  equipment             Equipment?           @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentCollectionId String?
  equipmentCollection   EquipmentCollection? @relation(fields: [equipmentCollectionId], references: [id], onDelete: Cascade)

  sortOrder Int      @default(100)
  createdAt DateTime @default(now())

  @@index([groupId, sortOrder])
  @@index([equipmentId])
  @@index([equipmentCollectionId])
}

// Company-level documents (Articles of Organization, Insurance certs, etc.).
// `type` is a string key into the DOCUMENT_TYPES setting taxonomy. A type can
// be flagged singleton in the taxonomy — enforced at the API layer.
// `currentVersionId` points at one of this doc's CompanyDocumentVersion rows.
model CompanyDocument {
  id          String    @id @default(cuid())
  type        String
  title       String
  description String?
  expiresAt   DateTime?
  // When true, Admins cannot see this document; only Super.
  adminHidden Boolean   @default(false)

  // Pointer to the currently-active version. Nullable while doc has no
  // uploaded version yet (e.g., metadata created but file not yet PUT).
  currentVersionId String?                 @unique
  currentVersion   CompanyDocumentVersion? @relation("CompanyDocCurrent", fields: [currentVersionId], references: [id], onDelete: SetNull)

  versions CompanyDocumentVersion[] @relation("CompanyDocVersions")

  createdById String
  createdBy   User   @relation("CompanyDocCreator", fields: [createdById], references: [id], onDelete: Restrict)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([type, archivedAt])
  @@index([expiresAt])
}

model CompanyDocumentVersion {
  id         String          @id @default(cuid())
  documentId String
  document   CompanyDocument @relation("CompanyDocVersions", fields: [documentId], references: [id], onDelete: Cascade)

  r2Key            String @unique
  contentType      String
  originalFilename String
  sizeBytes        Int

  uploadedById String
  uploadedBy   User     @relation("CompanyDocVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt   DateTime @default(now())

  // Back-relation for the currentVersion pointer on CompanyDocument.
  currentForDocument CompanyDocument? @relation("CompanyDocCurrent")

  @@index([documentId, uploadedAt])
}

// ─── Google Drive backup ────────────────────────────────────────────────
//
// Off-site backup of CompanyDocument + CompanyDocumentVersion into a
// folder in admin@'s Google Drive. Full spec:
// docs/features/documents-gdrive-backup.md.
//
// Two-table split:
//   DocumentSyncQueue — pending / in-progress work
//   DocumentSyncState — durable "what's in Drive now" map (folder per
//                       CompanyDocument, file per CompanyDocumentVersion,
//                       polymorphic on `kind`)
//
// The queue writes happen IN THE SAME TRANSACTION as each app mutation,
// so a sync task can't be lost between DB commit and the next worker run.

model DocumentSyncQueue {
  id            String   @id @default(cuid())
  // SYNC_DOCUMENT_METADATA | UPLOAD_DOCUMENT_VERSION |
  // DELETE_DOCUMENT_VERSION | MOVE_TO_DELETED | SYNC_TAXONOMY
  taskType      String
  // The CompanyDocument this task acts on (null for SYNC_TAXONOMY).
  documentId    String?
  // The CompanyDocumentVersion this task acts on (only version-level tasks).
  versionId     String?
  // Task-specific extra fields captured at enqueue time (e.g.
  // MOVE_TO_DELETED needs the title + versionCount because both are gone
  // from the DB by the time the worker runs).
  payload       Json?
  // PENDING | IN_PROGRESS | DONE | FAILED
  state         String   @default("PENDING")
  attempts      Int      @default(0)
  lastError     String?
  // Backoff — worker skips rows whose nextAttemptAt is in the future.
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([state, nextAttemptAt])
  @@index([documentId, state])
  @@index([taskType, state])
}

model DocumentSyncState {
  id           String   @id @default(cuid())
  // DOCUMENT (folder) | VERSION (file)
  kind         String
  // For DOCUMENT rows: the CompanyDocument.id (unique per doc).
  // For VERSION rows: the CompanyDocumentVersion.id (unique per version).
  entityId     String   @unique
  // Grouping key for VERSION rows so the worker can find all files
  // belonging to a document at once (matches the doc's entityId).
  // Null for DOCUMENT rows.
  documentId   String?
  // The Drive resource id — folderId for DOCUMENT, fileId for VERSION.
  driveId      String   @unique
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind])
  @@index([documentId])
}

// Timeline events — important upcoming dates surfaced in the Timeline tab
// alongside CompanyDocument expirations. `rrule` is a RFC 5545 RRULE string
// (e.g., "FREQ=YEARLY;BYMONTH=4;BYMONTHDAY=15"); empty/null = one-time at
// `anchorDate`. Hidden events (adminHidden=true) are visible to Super only.
model TimelineEvent {
  id              String    @id @default(cuid())
  title           String
  description     String?
  // String key into the TIMELINE_CATEGORIES setting taxonomy. Null = no
  // category (uncategorized in the UI).
  category        String?
  rrule           String?
  // First/canonical occurrence — used as RRULE DTSTART. Immutable reference.
  anchorDate      DateTime
  // The currently-active due date. Starts at anchorDate on create. The user
  // explicitly advances it via "mark complete," which sets it to the next
  // rrule occurrence after the current value. If it drifts into the past
  // without being marked complete, the event renders as OVERDUE — that's the
  // whole point of this field vs. live-computing next-future-date.
  nextDueDate     DateTime?
  // Timestamp of the most recent "mark complete" action — used for display
  // ("last completed Jan 2026") and audit trail.
  lastCompletedAt DateTime?
  adminHidden     Boolean   @default(false)
  archivedAt      DateTime?

  createdById String
  createdBy   User     @relation("TimelineEventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([anchorDate])
  @@index([nextDueDate])
  @@index([archivedAt])
}

// Home-tab banner notifications. An admin posts a message to one or more
// users (or everyone); each recipient sees it on Worker Home until they
// individually dismiss it. Dismissals are per-user — one person dismissing
// has no effect on anyone else's view.
model BannerNotification {
  id          String    @id @default(cuid())
  title       String?
  body        String    @db.Text
  createdById String
  createdBy   User      @relation("BannerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  // Optional self-expire — past this date the banner stops being shown to
  // anyone regardless of dismissal state. Null = no expiry.
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  recipients BannerRecipient[]
  dismissals BannerDismissal[]

  @@index([createdAt])
  @@index([expiresAt])
}

model BannerRecipient {
  id       String             @id @default(cuid())
  bannerId String
  userId   String
  banner   BannerNotification @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bannerId, userId])
  @@index([userId])
}

model BannerDismissal {
  id          String             @id @default(cuid())
  bannerId    String
  userId      String
  dismissedAt DateTime           @default(now())
  banner      BannerNotification @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bannerId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Worker workday tracking — per-worker daily clock-in/out for payroll.
//
// Tracks total time the worker spent "on the clock" each day, independent
// of per-job duration. A workday has a startedAt, optional endedAt, and a
// pause/resume cycle (same shape as JobOccurrence) that accumulates into
// totalPausedMs. Active duration = (endedAt or now) − startedAt −
// totalPausedMs − (now − pausedAt if currently paused).
//
// Workday time is INTENTIONALLY DECOUPLED from JobOccurrence time:
//   - Workday measures "was this worker on the clock?" (payroll basis).
//   - JobOccurrence measures "how long did this job take?" (planning basis).
// In a crew, one worker can pause their workday for lunch while a coworker
// keeps mowing the job — the job clock keeps running, the lunching worker
// stops accruing paid time. Coupling them would force one of those two
// readings to be wrong; see the planning thread for the full design.
//
// `workdayDate` is the ET calendar date of check-in. Stays the anchor even
// if work runs past midnight (worker checks in at 11 PM Tuesday, ends at 2
// AM Wednesday — row remains anchored to Tuesday). The unique constraint
// enforces "one row per worker per anchor day."
//
// `approvedAt` / `approvedById` are reserved for the admin-approval phase
// (built next). Empty for now; the loader + audit log already account for
// them so the approval phase is purely additive.
// ─────────────────────────────────────────────────────────────────────────────
model WorkerWorkday {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("WorkdayWorker", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  workdayDate String // YYYY-MM-DD in ET

  startedAt     DateTime
  endedAt       DateTime?
  pausedAt      DateTime?
  totalPausedMs Int       @default(0)

  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("WorkdayApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workdayDate])
  @@index([userId, startedAt])
  @@index([workdayDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Money-Ledger followup flag — polymorphic. A Super can flag any row that
// appears on the Super → Money → Ledger view (Payment, BusinessExpense, or
// Checkout rental income) for follow-up — e.g. "waiting on ACH to post",
// "vendor disputing", "reconcile against bank statement next month."
//
// One open flag per underlying row at a time (enforced by the unique
// partial-ish index pattern: (entityType, entityId, resolvedAt) — resolved
// rows can coexist with a fresh open flag because resolvedAt differs). The
// resolved row stays on the table so audit history is queryable.
//
// `entityType` is a free-form string (lowercase model name): "payment" |
// "businessExpense" | "checkout". Polymorphic so adding a new ledger row
// type later (e.g. Refund) doesn't need a schema migration.
//
// Audit trail: the route layer writes AuditEvent rows for FLAG / EDIT /
// RESOLVE actions — this model itself is just the indexable state.
// ─────────────────────────────────────────────────────────────────────────────
model LedgerFollowup {
  id String @id @default(cuid())

  entityType String // "payment" | "businessExpense" | "checkout"
  entityId   String

  note String? @db.Text

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("LedgerFollowupCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Null = open. Stamped on resolve; the resolving Super may differ from
  // the creator (one flags, another resolves).
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("LedgerFollowupResolver", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updatedAt DateTime @updatedAt

  // Drives the title-bar count fast — `WHERE resolvedAt IS NULL`.
  @@index([resolvedAt])
  // Drives "is this row flagged?" lookups on the Ledger render path.
  @@index([entityType, entityId, resolvedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Dual-use vehicles + business mileage tracking.
//
// Vehicles are personal-owned but used partly for business (e.g. the
// owner's truck). Workers record start/stop odometer for each business
// use session. Aggregated business miles × IRS standard-mileage rate
// gives the deductible portion at year-end.
//
// Only workers with an active VehicleAssignment can log mileage
// against a vehicle. Super manages the assignment list.
//
// Approval mirrors the Workday model: after the daily cutoff
// (WORKDAY_APPROVAL_CUTOFF_HOUR_ET setting), the previous day's
// entries surface in the Super approval queue. Approving locks the
// row; unapproved rows stay editable by the driver.
// ─────────────────────────────────────────────────────────────────────────────
model Vehicle {
  id           String  @id @default(cuid())
  displayName  String // "Mike's Ram 2500"
  make         String?
  vehicleModel String? // "model" is a Prisma reserved-ish word; use vehicleModel
  year         Int?
  plate        String?

  // ET calendar date business use began — used for depreciation and
  // as an anchor for the yearly business-miles rollup.
  inServiceDate String? // YYYY-MM-DD

  // Cached last-known odometer reading (from the most recent
  // MileageEntry.endOdometer). Used to prefill the next start-trip
  // odometer input; not authoritative.
  currentOdometer Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  assignments    VehicleAssignment[]
  mileageEntries MileageEntry[]

  @@index([archivedAt])
}

model VehicleAssignment {
  id        String @id @default(cuid())
  vehicleId String
  userId    String

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User    @relation("VehicleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt  DateTime  @default(now())
  // Soft-remove so historical mileage entries retain their FK context.
  archivedAt DateTime?

  @@unique([vehicleId, userId])
  @@index([userId, archivedAt])
}

// One row per business-mileage session. Multiple sessions per day
// per vehicle are allowed (driver stops for lunch, restarts, etc.).
// `entryDate` is the ET calendar date of `startedAt` — the anchor
// used by the daily approval flow.
model MileageEntry {
  id           String @id @default(cuid())
  vehicleId    String
  driverUserId String

  // ET calendar date of `startedAt`. Anchors the approval-queue grouping.
  entryDate String // YYYY-MM-DD

  startedAt     DateTime
  endedAt       DateTime?
  startOdometer Int
  endOdometer   Int?
  // Cached endOdometer − startOdometer for fast per-vehicle rollups.
  // NULL while a session is open (endedAt is null).
  miles         Float?

  notes String?

  approvedAt   DateTime?
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle  Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  driver   User    @relation("MileageEntryDriver", fields: [driverUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approver User?   @relation("MileageEntryApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([driverUserId, entryDate])
  @@index([vehicleId, entryDate])
  @@index([entryDate, approvedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Compliance policy system
// ─────────────────────────────────────────────────────────────────────────────
//
// Signed / acknowledged / uploaded-on-behalf documents workers must have on
// file. Replaces the old User.insuranceCert*, User.contractorAgreedAt, and
// User.w9Collected columns with a unified, versioned, admin-authored system.
//
// The predicate "is this worker current on all applicable policies?" is
// answered by lib/policyPredicate.computeComplianceState() — a pure function
// with a build-gate test locking its semantics down.

// A policy template. One row per compliance concept (Insurance, Safety SOP,
// Vehicle Policy, Photo Release, etc.). Versioned via PolicyDocumentVersion —
// `currentVersionId` points at whichever version is live right now.
model PolicyDocument {
  id                           String              @id @default(cuid())
  // Stable identifier — never changes. Used for logs, tests, and seed
  // idempotency. UI shows `title` instead.
  key                          String              @unique
  title                        String
  description                  String?
  // Which worker types must satisfy this policy. Empty array = no gate ever
  // fires (but INFO-level docs may still show it universally).
  targetWorkerTypes            WorkerType[]
  enforcement                  PolicyEnforcement
  // Determines what the worker experience looks like. NONE = admin-uploads-
  // on-behalf is the only path; worker sees it as informational on their
  // compliance tab. SIGN + ACKNOWLEDGE both open the sign wizard.
  workerAction                 PolicyWorkerAction
  // Admin can upload an artifact on behalf of a worker (bypassing worker
  // sign). Required = true when workerAction = NONE. Optional otherwise;
  // some SIGN docs (like safety) shouldn't allow admin bypass — set false.
  adminCanUploadOnBehalf       Boolean             @default(false)
  // Worker attaches a personal document alongside their signature — e.g.
  // insurance certificate, W-9 PDF. When false, wizard is content-only.
  requiresWorkerUpload         Boolean             @default(false)
  // UI label for the file input ("Certificate of Insurance", "IRS Form W-9").
  workerUploadLabel            String?
  // Comma-separated MIME allowlist ("application/pdf,image/*"). Null = server
  // default ("application/pdf,image/*").
  workerUploadAcceptedTypes    String?
  // Worker also declares an expiration date on their upload (insurance yes,
  // W-9 no). When true, uploadExpiresAt on the signature is required and
  // gates re-fire when it lapses.
  workerUploadRequiresExpiry   Boolean             @default(false)
  // Uploaded artifact needs admin verification before the signature counts as
  // current. Closes the old-insurance-flow gap where worker upload was
  // immediately trusted. Uploads sit in PolicyUploadStatus.PENDING_REVIEW
  // until admin decides.
  workerUploadRequiresApproval Boolean             @default(false)
  // When a signature stops being current on its own timing (independent of
  // version changes). resignParamDays: days-since-sign for DAYS_SINCE_SIGN.
  // resignParamMonthDay: MM-DD for ANNUAL_ON_DATE. ONE_TIME + ANNIVERSARY
  // ignore both.
  resignTrigger                PolicyResignTrigger
  resignParamDays              Int?
  resignParamMonthDay          String?
  // Which app actions this policy gates when enforcement = BLOCK. Iterated
  // by workday/jobs/equipment services at gate time.
  gatesServices                PolicyGateService[]
  // Additional job-price threshold — policy only gates JOB_CLAIM when the
  // job's effective price is at or above this value. Preserves today's
  // "insurance required on ≥$200 jobs" pattern; admin can create any
  // policy with any threshold.
  gatesJobsAbovePrice          Float?
  // Order in which multi-doc sign wizard presents pending policies. Lower
  // renders first.
  sortOrder                    Int                 @default(0)
  // Whichever version is live right now. Null before first publish.
  currentVersionId             String?             @unique
  // Whether publish sends push-only or full-channel notifications. Per-doc
  // so operators don't burn Twilio/Resend budget on low-priority publishes.
  notifyOnPublish              PolicyNotifyChannel @default(PUSH_ONLY)
  // Optional per-document override for the publish-time grace window in
  // hours. Null → fall back to the global POLICY_DEFAULT_GRACE_HOURS
  // setting (24). Zero → no grace, BLOCK gate fires the instant the version
  // is published. Use zero for federally-mandated documents where any
  // uncovered window is unacceptable. Positive → that many hours.
  graceHoursOverride           Int?

  // Soft-delete. Archived policies stop firing gates and disappear from
  // worker "Required now" list, but historic signatures remain queryable.
  archivedAt     DateTime?
  archivedById   String?
  archivedReason String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  currentVersion PolicyDocumentVersion?  @relation("PolicyCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions       PolicyDocumentVersion[] @relation("PolicyAllVersions")
  exceptions     PolicyException[]
  createdBy      User                    @relation("PolicyCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  archivedBy     User?                   @relation("PolicyArchiver", fields: [archivedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([archivedAt])
  @@index([sortOrder])
}

// One row per published (or draft) version of a policy's content. Content is
// immutable once PUBLISHED — changes require a new version. Two-eyes approval
// workflow: DRAFT → PENDING_APPROVAL → APPROVED → PUBLISHED, with rollback to
// ROLLED_BACK from PUBLISHED.
model PolicyDocumentVersion {
  id                 String              @id @default(cuid())
  policyDocumentId   String
  versionNumber      Int
  contentFormat      PolicyContentFormat
  // Present when contentFormat = MARKDOWN. Rendered client-side in the sign
  // wizard.
  contentMarkdown    String?
  // Present when contentFormat = PDF. R2 object key + display metadata.
  // pdfPageCount is populated at upload via pdf-lib on the server so the
  // wizard can build the per-page dwell/ack flow without client-side
  // parsing.
  contentR2Key       String?
  contentFileName    String?
  contentContentType String?
  pdfPageCount       Int?
  // SHA-256 hex of the exact content that will be shown to workers.
  // Immutable once PUBLISHED. Copied to each PolicySignature at sign time
  // so every signature can prove exactly what was on file.
  contentDigest      String
  // Admin's explanation of what changed vs prior version. Shown in the
  // approval queue and the compliance history.
  changeNote         String
  // Admin's explicit publish-time choice. True = existing signatures against
  // prior versions are treated as stale; workers must re-sign. False = typo
  // fix or trivial update; prior signatures still count.
  forcesResign       Boolean             @default(false)
  // Grace deadline. Signatures against superseded versions remain current
  // for THIS worker until graceUntil elapses. Default at publish is
  // publishedAt + POLICY_DEFAULT_GRACE_HOURS. Zero-grace requires admin to
  // type APPROVE.
  graceUntil         DateTime?
  status             PolicyVersionStatus @default(DRAFT)

  createdById      String
  createdAt        DateTime  @default(now())
  submittedAt      DateTime?
  submittedById    String?
  approvedAt       DateTime?
  approvedById     String?
  publishedAt      DateTime?
  publishedById    String?
  rolledBackAt     DateTime?
  rolledBackById   String?
  rolledBackReason String?

  policyDocument  PolicyDocument          @relation("PolicyAllVersions", fields: [policyDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentOnPolicy PolicyDocument?         @relation("PolicyCurrentVersion")
  signatures      PolicySignature[]
  readingProgress PolicyReadingProgress[]
  createdBy       User                    @relation("PolicyVersionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy     User?                   @relation("PolicyVersionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedBy      User?                   @relation("PolicyVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  publishedBy     User?                   @relation("PolicyVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rolledBackBy    User?                   @relation("PolicyVersionRollbacker", fields: [rolledBackById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([policyDocumentId, versionNumber])
  @@index([status])
  @@index([policyDocumentId, status])
}

// One row per signature (or per admin-upload-on-behalf). Immutable — never
// updated in-place, only revoked-and-replaced. userId is the WORKER whose
// compliance this row establishes; signedByUserId is the ACTOR (worker for
// self-sign, admin for on-behalf). onBehalfOfUserId is set only when actor
// differs from subject.
model PolicySignature {
  id                      String             @id @default(cuid())
  userId                  String
  policyDocumentVersionId String
  // What actually happened. NONE = admin-upload-on-behalf (no worker action).
  workerActionAtSign      PolicyWorkerAction
  signedByUserId          String
  onBehalfOfUserId        String?
  signedAt                DateTime           @default(now())

  // Filled when workerActionAtSign = SIGN. Both stored: raw for audit,
  // normalized for compare.
  typedNameRaw        String?
  typedNameNormalized String?
  // Server-captured at write time. Admin actor for on-behalf uploads.
  signatureIp         String?
  signatureUserAgent  String?
  // Copied from PolicyDocumentVersion at write time. Survives any future
  // refactor of the version content — proves what was signed.
  contentDigestAtSign String

  // Worker (or admin-on-behalf) uploaded artifact. Present when the policy
  // has requiresWorkerUpload = true.
  uploadR2Key           String?
  uploadFileName        String?
  uploadContentType     String?
  uploadDigest          String? // SHA-256 of uploaded bytes
  uploadExpiresAt       DateTime?
  uploadStatus          PolicyUploadStatus @default(NONE)
  uploadReviewedAt      DateTime?
  uploadReviewedById    String?
  uploadRejectionReason String?

  // Revoked signatures remain in DB for audit but never count as current.
  // Set by admin action (POLICY_SIGNATURE_REVOKED, POLICY_FORCE_RESIGN).
  revokedAt     DateTime?
  revokedById   String?
  revokedReason String?

  user       User                  @relation("PolicySignatureUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  version    PolicyDocumentVersion @relation(fields: [policyDocumentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  signedBy   User                  @relation("PolicySignatureActor", fields: [signedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  onBehalfOf User?                 @relation("PolicySignatureOnBehalfOf", fields: [onBehalfOfUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedBy User?                 @relation("PolicySignatureReviewer", fields: [uploadReviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  revokedBy  User?                 @relation("PolicySignatureRevoker", fields: [revokedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, signedAt])
  @@index([policyDocumentVersionId])
  @@index([userId, policyDocumentVersionId])
  @@index([uploadStatus])
  @@index([revokedAt])
}

// Time-bounded per-worker exception. While an active exception exists,
// `isSignatureCurrent` treats the worker as satisfying the policy regardless
// of signature state. Used sparingly — every grant / revoke is audited.
model PolicyException {
  id               String    @id @default(cuid())
  userId           String
  policyDocumentId String
  grantedById      String
  grantedAt        DateTime  @default(now())
  expiresAt        DateTime
  reason           String
  revokedAt        DateTime?
  revokedById      String?
  revokedReason    String?

  user           User           @relation("PolicyExceptionUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  policyDocument PolicyDocument @relation(fields: [policyDocumentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  grantedBy      User           @relation("PolicyExceptionGranter", fields: [grantedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revokedBy      User?          @relation("PolicyExceptionRevoker", fields: [revokedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, policyDocumentId])
  @@index([expiresAt])
}

// Per-page audit trail of what a worker viewed before signing. For PDF
// content the sign wizard requires the worker to dwell on each page N
// seconds before the sign button enables — each dwell fires a page-view
// record here. Rows are linked to the resulting PolicySignature once created
// so a compliance record includes a provable "worker viewed page X at time
// T from IP Y" chain.
model PolicyReadingProgress {
  id                      String   @id @default(cuid())
  userId                  String
  policyDocumentVersionId String
  pageNumber              Int
  ipAddress               String?
  userAgent               String?
  createdAt               DateTime @default(now())
  // Set once the resulting signature is created. Rows without a linked
  // signature after N days can be GC'd (Slice 6 nice-to-have).
  policySignatureId       String?

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  version PolicyDocumentVersion @relation(fields: [policyDocumentVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, policyDocumentVersionId])
  @@index([policySignatureId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Vanity URLs — configurable branded shortcuts served ONLY on satellite
// marketing domains (currently seedlings.pro; hardcoded in the route layer
// today, moves to an ALLOWED_DOMAINS setting when Phase 2 of the promo
// multi-domain work lands). Two kinds:
//
//   LANDING  — renders a marketing page in-app with headline, body,
//              optional image, and a CTA button. Same shape as the
//              promotion landing page items but standalone (not tied to
//              a Promotion).
//   REDIRECT — 302s to a configured URL. Effectively a per-slug URL
//              shortener owned by the operator (Calendly booking, phone
//              tel: link, external form, etc.).
//
// isDefault flag marks ONE landing page as the fallback rendered when a
// visitor hits a slug that doesn't exist. Only kind=LANDING can be
// default (redirect-as-default would loop the visitor into a bounce for
// every 404). Enforced in the service, not by DB constraint.
//
// Reserved slugs (blocked at editor + defense at route): sign-in, opt-out,
// pay, promotion, api, mo, _next, favicon.ico, robots.txt, sitemap.xml,
// vanity, admin, super. See services/vanityPages.ts RESERVED_SLUGS.
// ─────────────────────────────────────────────────────────────────────────────

enum VanityPageKind {
  LANDING
  REDIRECT
  ALIAS
}

model VanityPage {
  id   String @id @default(cuid())
  slug String @unique // "perties", "book", "fessional" — kebab-case, ≤40 chars

  kind      VanityPageKind @default(LANDING)
  isDefault Boolean        @default(false) // fallback for unknown-slug visitors

  // Landing fields (used when kind=LANDING; ignored for REDIRECT). Empty
  // strings when the operator hasn't filled a value — the frontend
  // handles empty gracefully.
  title    String @default("") // browser tab
  headline String @default("") // hero h1
  body     String @default("") @db.Text // markdown, main content

  // Legacy single-button fields — retained for backward compat with
  // rows created before the buttons column existed. New rows write to
  // buttons and leave these NULL. Reads prefer buttons when set; the
  // public API synthesizes a single-URL buttons array from these when
  // buttons is missing.
  ctaText    String?
  ctaUrl     String?
  // Multi-button JSON array. Each entry:
  //   { kind: "URL" | "PHONE" | "EMAIL", label: string, target: string }
  // target is stored raw — the renderer prefixes tel: / mailto: from
  // kind at request time so the raw phone/email stays easy to edit.
  buttons    Json?
  imageR2Key String? // hero image; served via presigned R2 URL

  // Redirect field (used when kind=REDIRECT). Required at save time when
  // kind=REDIRECT (service-layer validation).
  redirectUrl String?

  // Alias target (used when kind=ALIAS). Points at another VanityPage
  // whose LANDING content this row mirrors — same headline, body,
  // buttons, image — but rendered under this row's slug. On target
  // delete the FK is nulled (row still exists; renders blank until
  // fixed) rather than cascade-deleting the alias.
  aliasTargetId String?
  aliasTarget   VanityPage?  @relation("VanityAliasTarget", fields: [aliasTargetId], references: [id], onDelete: SetNull)
  aliasedBy     VanityPage[] @relation("VanityAliasTarget")

  // Enabled toggle — flip false to hide without deleting. Disabled rows
  // are treated as "not found" by the public route (falls through to the
  // default page).
  enabled Boolean @default(true)

  // Per-row opt-in for the app's startup typing animation. When the app
  // cold-starts (new tab / PWA launch / browser restart) it shows the
  // logo plus a typing animation that cycles through vanity URL slugs;
  // this flag controls which rows are included. When no row is checked
  // the app just shows the logo (no animation).
  showInStartupAnimation Boolean @default(false)

  // Operator-defined display order for the Vanity URLs tab. Lower
  // numbers first. Used by upcoming features that surface the list
  // in a specific sequence (e.g. an in-app navigation menu).
  sortOrder Int @default(0)

  // View analytics — fire-and-forget increment on every public render.
  // No per-day breakdown yet; add if needed.
  viewCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  updatedById String?
  createdBy   User?   @relation("VanityPageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("VanityPageUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([enabled, slug])
  @@index([isDefault])
  @@index([sortOrder])
  @@index([aliasTargetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYROLL — imported from Gusto, read-only, DECOUPLED from the financial system.
//
// Canonical spec: docs/features/payroll.md. Read it before changing anything
// here; the visibility rules in particular are the whole point of the feature.
//
// Gusto is the source of truth for pay. This app imports the Payroll Journal
// CSV so workers can see what they were ACTUALLY paid, alongside the estimates
// payments.ts derives. The two disagree by design.
//
// Nothing in these tables feeds Expense, P&L, or any tax export — not even
// employerCost, which is a real business cost but would double-count against
// the worker-payment math already in payments.ts.
// ─────────────────────────────────────────────────────────────────────────────

enum PayrollSourceKind {
  // A Gusto "Payroll Journal Report" — W-2 employees. The only kind today.
  EMPLOYEE_PAYROLL
  // Gusto pays 1099 contractors through a different report with a different
  // shape. Declared now, while the table is empty, so adding it later is a
  // new parser adapter rather than a migration plus a data backfill.
  CONTRACTOR_PAYMENTS
}

model PayrollPeriod {
  id String @id @default(cuid())

  sourceKind PayrollSourceKind @default(EMPLOYEE_PAYROLL)

  // ET date-keys (YYYY-MM-DD), parsed from the CSV's MM/DD/YYYY via the
  // canonical helper in lib/dates.ts. Stored as strings, not DateTime: these
  // are calendar days with no time component, and a DateTime would reintroduce
  // exactly the timezone drift docs/DATE_HANDLING.md exists to prevent.
  //
  // NATURAL KEY IS (periodStart, periodEnd) — payDay is deliberately NOT part
  // of it. Re-upload is the only edit path, so if payDay were in the key,
  // correcting a wrong pay day would create a SECOND period for the same week
  // instead of replacing the first.
  periodStart String
  periodEnd   String
  payDay      String

  /// Gusto's descriptive label, e.g. "Weekly Payroll". Display only — never
  /// branch on it. Pay cadence can change and the label is not a contract.
  label String?

  /// R2 key of the original uploaded CSV, kept forever. These numbers are only
  /// trustworthy because the source file they came from is still on disk.
  sourceR2Key String

  /// The parsed "Payroll Totals" row, verbatim. Entries must sum to this at
  /// import time (cent precision — money is Float here, matching Payment).
  totals Json

  uploadedById String
  uploadedBy   User   @relation("PayrollUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Soft delete, matching the repo-wide archivedAt/retiredAt pattern. Super
  /// only. Hard-deleting a payroll record should not be recoverable-from-
  /// backup-only.
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("PayrollArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  entries PayrollEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Partial-unique is not expressible in Prisma, so the natural key is unique
  // across archived rows too. Replacement mutates the existing row in place
  // rather than archiving-and-inserting, so this holds.
  @@unique([periodStart, periodEnd])
  @@index([payDay])
  @@index([archivedAt])
  @@index([uploadedById])
}

model PayrollEntry {
  id String @id @default(cuid())

  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// NULL until a Super confirms who this row belongs to. The CSV carries no
  /// employee identifier — only a first and last name — so rows are NEVER
  /// auto-matched. Unmatched rows are still stored (or the totals stop
  /// balancing) and are invisible to every worker.
  userId String?
  user   User?   @relation("PayrollEntryUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  rawLastName  String
  rawFirstName String

  employeeType  String?
  paymentMethod String?
  workAddress   String?

  // Money + hours. NULLABLE ON PURPOSE: the CSV distinguishes "" (not
  // applicable) from "0.00" (computed to zero) and so do we. Collapsing both
  // to 0 would make "did we owe FUTA this period?" unanswerable.
  regularHours  Float?
  regularRate   Float?
  regularAmount Float?

  additionalEarnings Float?
  grossEarnings      Float?

  employeeTaxes              Float?
  federalIncomeTax           Float?
  socialSecurityEmployee     Float?
  medicareEmployee           Float?
  additionalMedicareEmployee Float?
  /// Gusto names this column per-jurisdiction ("NC State Tax (Employee)"), so
  /// the parser matches it by pattern, not literal. `raw` keeps the original
  /// header if the state ever matters.
  stateTaxEmployee           Float?

  employerTaxes             Float?
  socialSecurityEmployer    Float?
  medicareEmployer          Float?
  futaEmployer              Float?
  /// Same per-jurisdiction naming as stateTaxEmployee.
  stateUnemploymentEmployer Float?

  netPay         Float?
  reimbursements Float?
  donations      Float?
  checkAmount    Float?
  employerCost   Float?

  /// The complete source row, verbatim, keyed by original CSV header. Typed
  /// columns above cover what the UI renders; this covers everything else —
  /// a new state's tax line, a renamed Gusto column, a question nobody has
  /// asked yet. Costs a query instead of a re-import.
  raw Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payrollPeriodId])
  @@index([userId])
  @@index([rawLastName, rawFirstName])
}

model PayrollIdentity {
  id String @id @default(cuid())

  // Matched case-insensitively by the service; stored as they appear in the
  // CSV so the review UI can show a Super exactly what Gusto wrote.
  lastName  String
  firstName String

  userId String
  user   User   @relation("PayrollIdentityUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  confirmedById String
  confirmedBy   User     @relation("PayrollIdentityConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lastName, firstName])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Education guides — see docs/features/education.md
//
// Shape deliberately mirrors PolicyDocument / PolicyDocumentVersion: a
// stable parent row, an append-only version chain, and a pointer to the
// one version the audience sees. Copied rather than shared because
// policies carry signatures, compliance state and forced re-signing, none
// of which apply to training material.
// ─────────────────────────────────────────────────────────────────────────

model Guide {
  id          String   @id @default(cuid())
  /// URL-safe stable handle. Survives re-titling so deep links don't rot.
  slug        String   @unique
  title       String
  /// One-line catalog blurb. Searchable; not part of the approved body.
  summary     String?
  /// Category KEY from the GUIDE_CATEGORIES setting — a settings-driven
  /// taxonomy, not a DB enum, so adding "Irrigation" needs no migration.
  categoryKey String
  /// Free-form tags, lower-cased on write. Searched alongside title/body.
  tags        String[]

  /// The PUBLISHED version workers read. Null until first publish, which
  /// is what keeps an unapproved guide invisible without a status flag on
  /// the parent row.
  currentVersionId String?        @unique
  currentVersion   GuideVersion?  @relation("GuideCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         GuideVersion[] @relation("GuideAllVersions")
  assets           GuideAsset[]   @relation("GuideAssets")

  createdById String
  createdBy   User   @relation("GuideCreator", fields: [createdById], references: [id], onDelete: Restrict)

  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("GuideArchiver", fields: [archivedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryKey, archivedAt])
  @@index([archivedAt])
}

model GuideVersion {
  id            String @id @default(cuid())
  guideId       String
  versionNumber Int

  contentMarkdown String
  /// sha256 of contentMarkdown. Lets "did this actually change?" be
  /// answered without diffing, the same way policy versions do it.
  contentDigest   String
  /// Required on submit — an approver seeing a new version with no
  /// explanation has to diff it by eye.
  changeNote      String

  status GuideVersionStatus @default(DRAFT)

  createdById   String
  createdBy     User      @relation("GuideVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?     @relation("GuideVersionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?     @relation("GuideVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("GuideVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  /// REJECTED is ours, not policies' — "send it back with a note" is the
  /// common review outcome for training content, and without it an
  /// author's only signal is the version silently reverting to draft.
  rejectedAt    DateTime?
  rejectedById  String?
  rejectedBy    User?     @relation("GuideVersionRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionNote String?

  guide          Guide  @relation("GuideAllVersions", fields: [guideId], references: [id], onDelete: Cascade)
  currentOnGuide Guide? @relation("GuideCurrentVersion")

  @@unique([guideId, versionNumber])
  @@index([status])
  @@index([guideId, status])
}

model GuideAsset {
  id   String         @id @default(cuid())
  kind GuideAssetKind

  /// Object key in the guide-media bucket. IMMUTABLE: an asset is never
  /// re-uploaded in place, because a published page's media would then
  /// change without an approver seeing it. "Replacing" an image writes a NEW
  /// asset and supersedes this one — the bytes behind a given key never move.
  r2Key       String @unique
  contentType String

  /// The name guides reference. UNIQUE, and lower-cased on the way in, so a
  /// body can say `![alt](grass-id-chart.png)` and the system resolves it —
  /// authoring against an opaque cuid was the wrong trade, and it broke
  /// silently every time content moved between environments.
  ///
  /// Uniqueness is enforced across LIVE assets only. A superseded row keeps
  /// its bytes for audit but has its name suffixed on the way out, which is
  /// what frees the name for its replacement.
  originalFilename String @unique

  /// Set when a newer upload took this asset's name. The row and its object
  /// stay — an audit trail of what a published page used to show — but
  /// nothing resolves to it any more.
  supersededAt   DateTime?
  supersededById String?
  /// VERIFIED size read back from R2 after upload, not the size the
  /// browser declared. A presigned PUT is signed on content-type only, so
  /// the declared number is unenforceable — and an unchecked figure shown
  /// as metadata is exactly the kind of number that is wrong for a year.
  sizeBytes      Int
  /// Alt text / caption. Required for images.
  altText        String?
  /// Set when a Super knowingly uploaded past GUIDE_MAX_VIDEO_MB.
  sizeOverride   Boolean   @default(false)

  /// Optional owning guide — assets can also live unattached in the
  /// library and be referenced by several guides.
  guideId String?
  guide   Guide?  @relation("GuideAssets", fields: [guideId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User     @relation("GuideAssetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt   DateTime @default(now())

  @@index([kind, uploadedAt])
  @@index([guideId])
  @@index([uploadedById])
}

/// A saved pay-structure scenario from the Super forecasting tool
/// (Money -> Forecast). ADVISORY ONLY — a Forecast never writes a Setting,
/// never touches a Payment, and pays nobody. It is a saved question, not a
/// decision that has been executed.
///
/// Why the assumption set is JSON rather than columns: every new lever we
/// want to model (a rate card, a tiered margin, a minimum invoice, a
/// hypothetical hire) would otherwise be a migration, and the whole point of
/// the tool is to model levers the app does not implement yet. The shape is
/// validated in services/forecast.ts, which owns the schema.
model Forecast {
  id    String  @id @default(cuid())
  name  String
  notes String?

  /// Baseline sample window, ET date keys (YYYY-MM-DD).
  windowFrom String
  windowTo   String

  /// Optional second window, for putting one season beside another. Seasonal
  /// swing in this business is large enough that a single window is often
  /// the wrong basis for an annual decision.
  compareFrom String?
  compareTo   String?

  /// Slider positions, roster overrides, and hypothetical workers.
  assumptions Json

  /// What the baseline looked like WHEN THE FORECAST WAS SAVED. Kept so a
  /// scenario reopened months later can show its original numbers next to
  /// freshly-queried ones: late-confirmed payments and back-dated expenses
  /// both move a historical window after the fact. Without the snapshot a
  /// forecast silently rewrites itself and the operator has no way to see
  /// that the ground moved.
  baselineSnapshot   Json?
  baselineCapturedAt DateTime?

  /// Last AI assessment of this scenario, cached so reopening a saved
  /// forecast doesn't silently spend another model call. Cleared whenever
  /// the assumptions change, because an assessment of superseded numbers is
  /// worse than none.
  assessment Json?
  assessedAt DateTime?

  createdById String
  createdBy   User   @relation("ForecastAuthor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Soft delete, matching the archivedAt/retiredAt convention used across
  /// the schema.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([createdById])
  @@index([archivedAt, updatedAt])
}

/// Generic cache for values fetched from external services.
///
/// Exists because in-memory caching is close to useless on serverless — every
/// cold start is a fresh process — and the services behind these values are
/// rate-limited (BLS ~25/day keyless), throttled (NWS), or billed per call
/// (Mapbox geocoding). Before this, `/api/weather` had no server-side cache at
/// all and every worker's browser poll was a fresh pair of OpenWeather calls.
///
/// NOT for anything with a natural owning row. Parcel data lives on Property,
/// a Forecast's AI assessment lives on Forecast; those have a home and moving
/// them here would be worse. This is only for values that belong to the
/// business as a whole.
///
/// `expiresAt` is REQUIRED — an entry with no expiry is a leak, and the helper
/// in lib/cache.ts will not write one. Expired rows are deliberately KEPT for
/// a long grace period so a failed refresh can serve the last known-good value
/// rather than nothing (see the stale-on-error path); pruning only removes
/// entries that have been expired long enough to be useless.
model CacheEntry {
  /// Namespaced by the helper: "marketRate:<addr>|<soc>", "geocode:<address>".
  key       String   @id
  /// The declared namespace on its own, so entries can be inspected, counted
  /// and invalidated as a group. Must be one of CACHE_NAMESPACES.
  namespace String
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([namespace])
  @@index([expiresAt])
}
