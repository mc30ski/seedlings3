  name        String
  description String?  @db.Text
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items              EquipmentCollectionItem[]
  jobRecommendations JobRecommendedCollection[]
  groupPreferences   GroupPreferredEquipment[]

  @@index([sortOrder, name])
}

model EquipmentCollectionItem {
  id           String @id @default(cuid())
  collectionId String
  equipmentId  String
  sortOrder    Int    @default(100)

  collection EquipmentCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  equipment  Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([collectionId, equipmentId])
  @@index([equipmentId])
  @@index([collectionId, sortOrder])
}

model JobRecommendedCollection {
  id           String @id @default(cuid())
  jobId        String
  collectionId String
  sortOrder    Int    @default(100)

  job        Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  collection EquipmentCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([jobId, collectionId])
  @@index([jobId, sortOrder])
}

model OccurrenceComment {
  id String @id @default(cuid())

  occurrenceId String
  occurrence   JobOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([occurrenceId])
  @@index([authorId])
}

model CalendarFeedToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token          String    @unique
  label          String?
  filters        Json
  createdAt      DateTime  @default(now())
  lastAccessedAt DateTime?

  @@index([userId])
  @@index([token])
}

model Reminder {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  occurrenceId String
  occurrence   JobOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  remindAt    DateTime
  note        String?
  dismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, occurrenceId])
  @@index([userId, remindAt])
}

model FollowupClient {
  id           String        @id @default(cuid())
  occurrenceId String
  occurrence   JobOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@unique([occurrenceId, clientId])
