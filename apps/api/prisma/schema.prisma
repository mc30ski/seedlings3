  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  r2Key        String
  fileName     String?
  contentType  String?
  description  String?
  sortOrder    Int      @default(0)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  jobDefaults    JobPropertyPhoto[]
  occurrenceRefs OccurrencePropertyPhoto[]

  @@index([propertyId])
}

model JobPropertyPhoto {
  id              String        @id @default(cuid())
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  propertyPhotoId String
  propertyPhoto   PropertyPhoto @relation(fields: [propertyPhotoId], references: [id], onDelete: Cascade)

  @@unique([jobId, propertyPhotoId])
}

model OccurrencePropertyPhoto {
