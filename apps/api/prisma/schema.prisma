generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  WORKER
  ADMIN
  SUPER
}

enum EquipmentStatus {
  AVAILABLE
  RESERVED
  CHECKED_OUT
  MAINTENANCE
  RETIRED
}

enum AuditScope {
  USER
  EQUIPMENT
  CLIENT
  JOB
  PROPERTY
  SETTING
  NOTIFICATION
  DOCUMENT
  TIMELINE
  BANNER
  PAYMENT
  EXPORT
  WORKDAY
  LEDGER_FOLLOWUP
  POLICY_DOCUMENT
  POLICY_SIGNATURE
  PROMOTION
  GUIDE
  GUIDE_ASSET
  PROMO_OPT
  VANITY
  // add more scopes as you expand the schema

  // Added 2026-08-22 after a system-wide audit-coverage sweep found
  // these domains mutating state with no audit trail at all.
  EXPENSE
  SUPPLY
  MILEAGE
  GROUP
  VEHICLE
  CHANGE_REQUEST
  EQUIPMENT_COLLECTION
  CALENDAR_FEED

  // Added 2026-08-24 with the Payroll feature (docs/features/payroll.md).
  // Covers CSV imports of Gusto payroll journals, whole-period replacement,
  // archiving, and the name -> User identity mapping.
  PAYROLL

  // Added 2026-09-02 with the Super forecasting tool (Money -> Forecast).
  // A forecast changes no live setting and pays nobody, but it is the
  // document a pay-structure decision gets argued from, so who built it,
  // who edited the assumptions, and who deleted it are all worth keeping.
  FORECAST
}

enum AuditVerb {
  APPROVED
  ROLE_ASSIGNED
  ROLE_REMOVED
  CREATED
  UPDATED
  RETIRED
  UNRETIRED
  DELETED
  CHECKED_OUT
  RELEASED
  MAINTENANCE_START
  MAINTENANCE_END
  RESERVED
  RESERVATION_CANCELLED
  RETURNED
  FORCE_RELEASED
  PRIMARY_CONTACT_SET
  SETTING_UPDATED
  WORKER_TYPE_SET
  SENT
  VERSION_ADDED
  VERSION_RESTORED
  VERSION_DELETED
  VIEWED
  DOWNLOADED
  COMPLETED
  SELF_REPORTED
  REJECTED
  REQUEST_SENT
  TOKEN_ACCESSED
  WRITTEN_OFF
  SKIPPED
  UNSKIPPED
  ADJUSTED
  OWNER_EARNINGS_RECORDED
  FEE_APPLIED
  PAYMENT_METHOD_UPDATED
  // RETIRED 2026-08-31 with the guaranteed-payout feature. The enum values
  // MUST stay: production AuditEvent rows still reference them, and dropping
  // a Postgres enum value with live rows fails the migration. Nothing writes
  // these any more; HistoryTab still renders their labels so the historical
  // rows remain readable.
  GUARANTEED_PAYOUT_STARTED
  GUARANTEED_PAYOUT_ENDED
  SIGN_IN

  // Forecast lifecycle (Money -> Forecast). DUPLICATED is its own verb
  // rather than CREATED so the trail distinguishes a scenario built from
  // scratch from one branched off an existing set of assumptions.
  DUPLICATED
  ASSESSED
  // Compliance-policy verbs. See models Policy* below. Replaces the
  // old-insurance-flow verbs INSURANCE_UPLOADED, CONTRACTOR_AGREED,
  // and W9_COLLECTED (removed with the tear-out).
  POLICY_VERSION_DRAFTED
  POLICY_VERSION_SUBMITTED_FOR_APPROVAL
  POLICY_VERSION_APPROVED
  POLICY_VERSION_PUBLISHED
  POLICY_VERSION_ROLLED_BACK
  POLICY_SIGNED
  POLICY_SIGNATURE_REVOKED
  POLICY_UPLOAD_REVIEWED
  POLICY_FORCE_RESIGN
  POLICY_EXCEPTION_GRANTED
  POLICY_EXCEPTION_REVOKED
  POLICY_ARCHIVED
  POLICY_UNARCHIVED
  POLICY_ADMIN_UPLOADED_ON_BEHALF
  // Promotion lifecycle verbs. Scope: PROMOTION. See models Promotion /
  // PromotionDelivery below.
  PROMOTION_STARTED
  PROMOTION_PAUSED
  PROMOTION_RESUMED
  PROMOTION_RETIRED
  PROMOTION_EDITED
  PROMOTION_DUPLICATED
  PROMOTION_DISPATCHED
  PROMOTION_TEST_SENT
  // Rotation of the auto-managed PROMOTION_HMAC_SECRET (Super-only).
  // Metadata carries { previousSecretPreviewHash, rotatedAt }. Rotating
  // invalidates every in-flight promo click URL's attribution (still
  // redirects, logs as anonymous).
  PROMOTION_HMAC_ROTATED
  // Opt-out / opt-in for promotional messages. Scope: PROMO_OPT. The
  // metadata JSON always includes { source, channel, [reason] } — see
  // services/promotions.ts for canonical shape.
  PROMO_OPTED_OUT
  PROMO_OPTED_IN
  // add new verbs as needed

  // Added 2026-08-22 — see the AuditScope note above.
  PURCHASE_RECORDED
  HOLD_CREATED
  HOLD_REMOVED
  HOLD_ADJUSTED
  UNAPPROVED
  RECONCILED
  RECEIPT_ATTACHED
  RECEIPT_DELETED
  ADDON_ADDED
  ADDON_REMOVED
  OCCURRENCE_DELETED
  PHOTO_DELETED
  COMMENT_DELETED
  DENIED
  SPLITS_UPDATED
  WAGE_UPDATED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_UPDATED
  ASSIGNED
  UNASSIGNED
  CANCELED

  // Payroll verbs. Scope: PAYROLL. See docs/features/payroll.md.
  // PAYROLL_REPLACED carries a full snapshot of the entries it displaced —
  // re-upload is the ONLY edit path, so the audit row is the sole record of
  // what the numbers were before.
  PAYROLL_UPLOADED
  PAYROLL_REPLACED
  PAYROLL_ARCHIVED
  PAYROLL_IDENTITY_LINKED
  PAYROLL_IDENTITY_UNLINKED

  // Education-guide verbs. Scopes: GUIDE, GUIDE_ASSET. See
  // docs/features/education.md. PUBLISHED/UNPUBLISHED move what workers
  // can see; PURGED is the irreversible one and carries a full snapshot
  // of the guide and every version it destroyed.
  SUBMITTED
  PUBLISHED
  UNPUBLISHED
  ROLLED_BACK
  PURGED
  SIZE_LIMIT_OVERRIDDEN
}

enum WorkerType {
  EMPLOYEE
  CONTRACTOR
  TRAINEE
}

// ── Compliance policy system ─────────────────────────────────────────────────
// Documents workers must sign / acknowledge / have on file. Replaces the old
// insurance / W-9 / contractor-agreement User columns with a unified system
// that supports versioning, approval workflow, per-worker exceptions,
// admin-uploaded-on-behalf, and configurable gating across workday-start,
// job-claim, and vehicle-reserve. See models Policy* below and
// services/policies.ts. Full policy design memo lives with the PR.

enum PolicyWorkerAction {
  SIGN // full typed-name + acknowledgment
  ACKNOWLEDGE // click-through "I've read this"
  NONE // admin-upload-on-behalf only (worker never touches it)
}

enum PolicyEnforcement {
  BLOCK // gate services listed in gatesServices
  WARN // banner-only, no gate
  INFO // visible in compliance tab, no other surface
}

enum PolicyResignTrigger {
  ONE_TIME
  DAYS_SINCE_SIGN
  ANNIVERSARY // 365 days from each worker's last sign (personal clock)
  ANNUAL_ON_DATE // everyone re-signs by a fixed calendar date (fleet clock)
}

enum PolicyGateService {
  WORKDAY_START
  JOB_CLAIM
  // RESERVE_EQUIPMENT works differently from the other two: WORKDAY_START
  // and JOB_CLAIM in a policy's gatesServices act as global gates (that
  // action is blocked while the policy is pending). RESERVE_EQUIPMENT is an
  // "eligibility flag" — presence means the policy CAN be attached to
  // individual equipment via Equipment.requiredPolicyIds, but the block
  // only fires when a specific piece of equipment lists this policy. This
  // gives per-piece granularity — reserving a broom vs reserving the truck
  // can require different documents.
  RESERVE_EQUIPMENT
}

enum PolicyContentFormat {
  MARKDOWN
  PDF
}

enum PolicyNotifyChannel {
  PUSH_ONLY
  ALL_CHANNELS
}

/// Education-guide version lifecycle. Mirrors PolicyVersionStatus — the
/// same DRAFT → review → live shape — but kept SEPARATE because guides
/// carry no signatures, compliance state or forced re-signing, and
/// sharing the enum would invite sharing the semantics.
enum GuideVersionStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  ROLLED_BACK
}

/// Media kind for a guide asset. Drives who may upload it: IMAGE is
/// Admin+, VIDEO is Super-only (see docs/features/education.md — video is
/// the only asset class that can quietly become expensive, and the only
/// one with a format/playback trap worth concentrating in one person).
enum GuideAssetKind {
  IMAGE
  VIDEO
}

enum PolicyVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  ROLLED_BACK
}

enum PolicyUploadStatus {
  NONE
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String?
  phone       String?
  firstName   String?
  lastName    String?
  displayName String?
  isApproved  Boolean @default(false)

  workerType           WorkerType?
  homeBaseAddress      String?
  availableDays        String? // JSON array of day numbers, e.g. "[1,2,3,4,5]" (0=Sun,6=Sat)
  availableHoursPerDay Float? // default 4 if null

  // Hourly pay rate used for the Reconcile → Payroll export. Set per
  // worker so the Payroll card can render `hours × hourlyWage` =
  // regular wages, and the operator types `additionalEarnings` (the
  // delta between target gross and regular wages) into Gusto.
  // Defaults to 0 so contractors (paid lump-sum) and unconfigured
  // workers render predictably — Regular Wages = 0, Additional
  // Earnings absorbs the full target gross.
  hourlyWage Decimal @default(0) @db.Decimal(10, 2)

  // Privilege overrides. Null = follow workerType default (resolved in app
  // code via DEFAULTS_BY_WORKERTYPE). True/false = explicit override.
  //
  //   canPullInventory  defaults: TRAINEE=false, CONTRACTOR/EMPLOYEE=true
  //   canChargeBusinessExpenses  defaults: false everywhere (granted explicitly)
  //
  // Admin/Super always have both effectively true regardless of these
  // columns — the role guard wins.
  canPullInventory          Boolean?
  canChargeBusinessExpenses Boolean?

  // Compliance-policy sign / upload / exception state lives entirely in
  // the PolicyDocument / PolicyDocumentVersion / PolicySignature /
  // PolicyException / PolicyReadingProgress model chain. There is no
  // per-user column here — the "is this worker compliant?" question is
  // answered by policyPredicate.computeComplianceState() against those
  // relations. See services/policies.ts.

  // LLC-owner flag. At most one user may have this set to true (enforced via
  // partial unique index in the migration). Additive to ADMIN/SUPER role —
  // does not replace it. The owner participates in jobs like any worker;
  // their PaymentSplit rows get ownerEarnings=true, which the Gusto/payroll
  // exports filter out (the owner takes a draw, not a paycheck).
  isOwner Boolean @default(false)

  // Per-user override for payment-request delivery channel.
  // null = use the org-wide DEFAULT_PAYMENT_COMMUNICATIONS_MODE setting.
  paymentCommsMode PaymentCommsMode?

  // Sign-in tracking. The auth plugin records a SIGN_IN audit event
  // the first time it sees a new Clerk session id (`sid` claim) for
  // this user. `sid` is stable across the silent JWT refreshes that
  // happen every ~60 seconds while a tab is open, so each real
  // browser session records ONE sign-in (not one per minute). A
  // prior implementation used `iat`, which changes on every refresh —
  // that produced a spurious SIGN_IN entry every time the SDK rotated
  // the token, even for idle tabs. `lastSignInAt` mirrors the most-
  // recent SIGN_IN audit row for fast card rendering.
  lastSignInAt  DateTime?
  lastSessionId String?

  roles          UserRole[]
  checkouts      Checkout[]
  checkoutSplits CheckoutSplit[]
  auditEvents    AuditEvent[]    @relation("AuditActor")

  // Groups
  groupsClaimed    Group[]       @relation("GroupClaimer")
  groupMemberships GroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobDefaultAssignments    JobAssigneeDefault[]
  jobOccurrenceAssignments JobOccurrenceAssignee[]
  jobAssignmentAuditActor  JobOccurrenceAssignee[] @relation("JobAssignActor")

  paymentsCollected          Payment[]                 @relation("PaymentCollector")
  paymentsConfirmed          Payment[]                 @relation("PaymentConfirmer")
  paymentsAdjusted           Payment[]                 @relation("PaymentAdjuster")
  paymentsWrittenOff         Payment[]                 @relation("PaymentWriteOff")
  paymentsSkipped            Payment[]                 @relation("PaymentSkip")
  paymentSplits              PaymentSplit[]
  expenses                   Expense[]
  photos                     JobOccurrencePhoto[]
  settingsUpdated            Setting[]
  pinnedOccurrences          PinnedOccurrence[]
  likedOccurrences           LikedOccurrence[]
  reminders                  Reminder[]
  calendarFeedTokens         CalendarFeedToken[]
  occurrenceComments         OccurrenceComment[]
  propertyPhotosUploaded     PropertyPhoto[]
  equipmentPhotosUploaded    EquipmentPhoto[]
  occurrenceAddons           OccurrenceAddon[]
  pinnedEquipment            PinnedEquipment[]
  likedEquipment             LikedEquipment[]
  businessExpenses           BusinessExpense[]
  businessExpensesReconciled BusinessExpense[]         @relation("BusinessExpenseReconciler")
  businessExpenseSeriesEnded BusinessExpense[]         @relation("BusinessExpenseSeriesEnder")
  changeRequestsCreated      OccurrenceChangeRequest[] @relation("ChangeRequestRequester")
  changeRequestsResolved     OccurrenceChangeRequest[] @relation("ChangeRequestResolver")
  hoursApproved              JobOccurrence[]           @relation("HoursApprover")
  pushSubscriptions          PushSubscription[]

  suppliesCreated          Supply[]
  supplyPurchasesCreated   SupplyPurchase[]
  supplyHoldsCreated       SupplyHold[]
  supplyAdjustmentsCreated SupplyAdjustment[]

  companyDocumentsCreated  CompanyDocument[]        @relation("CompanyDocCreator")
  documentVersionsUploaded CompanyDocumentVersion[] @relation("CompanyDocVersionUploader")

  timelineEventsCreated TimelineEvent[] @relation("TimelineEventCreator")

  bannersCreated   BannerNotification[] @relation("BannerCreator")
  bannerRecipients BannerRecipient[]
  bannerDismissals BannerDismissal[]

  // Workday tracking — per-worker daily clock-in/out for payroll. See
  // WorkerWorkday model. `workdaysApproved` is the back-relation for the
  // admin-approval phase (built later; the field exists now so the schema
  // doesn't need a follow-up migration).
  workdays         WorkerWorkday[] @relation("WorkdayWorker")
  workdaysApproved WorkerWorkday[] @relation("WorkdayApprover")

  // Money-Ledger followup flags this Super created and (separately) resolved.
  // Two relations because creator and resolver can differ — one Super flags,
  // another resolves. The flag itself targets any of Payment / BusinessExpense
  // / Checkout via the polymorphic (entityType, entityId) pair on the row.
  ledgerFollowupsCreated  LedgerFollowup[] @relation("LedgerFollowupCreator")
  ledgerFollowupsResolved LedgerFollowup[] @relation("LedgerFollowupResolver")

  // Dual-use vehicle assignments — this worker can log mileage against
  // these vehicles. Super manages the assignment list. Same worker can
  // be assigned to multiple vehicles (one per row).
  vehicleAssignments     VehicleAssignment[] @relation("VehicleAssignmentUser")
  // Mileage entries this user drove, and (separately) approved.
  mileageEntriesAsDriver MileageEntry[]      @relation("MileageEntryDriver")
  mileageEntriesApproved MileageEntry[]      @relation("MileageEntryApprover")

  // Compliance-policy relations. See PolicyDocument / PolicyDocumentVersion /
  // PolicySignature / PolicyException / PolicyReadingProgress models.
  policiesCreated            PolicyDocument[]        @relation("PolicyCreator")
  policiesArchived           PolicyDocument[]        @relation("PolicyArchiver")
  policyVersionsCreated      PolicyDocumentVersion[] @relation("PolicyVersionCreator")
  policyVersionsSubmitted    PolicyDocumentVersion[] @relation("PolicyVersionSubmitter")
  policyVersionsApproved     PolicyDocumentVersion[] @relation("PolicyVersionApprover")
  policyVersionsPublished    PolicyDocumentVersion[] @relation("PolicyVersionPublisher")
  policyVersionsRolledBack   PolicyDocumentVersion[] @relation("PolicyVersionRollbacker")
  policySignatures           PolicySignature[]       @relation("PolicySignatureUser")
  policySignaturesSigned     PolicySignature[]       @relation("PolicySignatureActor")
  policySignaturesOnBehalfOf PolicySignature[]       @relation("PolicySignatureOnBehalfOf")
  policySignaturesReviewed   PolicySignature[]       @relation("PolicySignatureReviewer")
  policySignaturesRevoked    PolicySignature[]       @relation("PolicySignatureRevoker")
  policyExceptionsAsSubject  PolicyException[]       @relation("PolicyExceptionUser")
  policyExceptionsGranted    PolicyException[]       @relation("PolicyExceptionGranter")
  policyExceptionsRevoked    PolicyException[]       @relation("PolicyExceptionRevoker")
  policyReadingProgress      PolicyReadingProgress[]

  // Promotion audit-actor back-relations. All use onDelete:SetNull on
  // the forward side so hard-deleting a Super doesn't destroy audit
  // history — the row lingers with a null actor and the UI renders
  // "unknown" instead of a dangling FK.
  promotionsCreated            Promotion[]            @relation("PromotionCreator")
  promotionsUpdated            Promotion[]            @relation("PromotionUpdater")
  promotionsStarted            Promotion[]            @relation("PromotionStarter")
  promotionsClosed             Promotion[]            @relation("PromotionCloser")
  promotionLandingPagesCreated PromotionLandingPage[] @relation("PromotionLandingCreator")
  promotionLandingPagesUpdated PromotionLandingPage[] @relation("PromotionLandingUpdater")
  // Vanity URL audit-actor back-relations — SetNull on the forward
  // side (see VanityPage) so hard-deleting a Super doesn't destroy
  // audit history.
  vanityPagesCreated           VanityPage[]           @relation("VanityPageCreator")
  vanityPagesUpdated           VanityPage[]           @relation("VanityPageUpdater")

  // Payroll (docs/features/payroll.md). payrollEntries is the worker's OWN
  // imported rows — the relation a worker-scoped query hangs off.
  payrollPeriodsUploaded PayrollPeriod[] @relation("PayrollUploadedBy")
  payrollPeriodsArchived PayrollPeriod[] @relation("PayrollArchivedBy")
  payrollEntries         PayrollEntry[]  @relation("PayrollEntryUser")

  /// Saved pay-structure scenarios this user authored (Money -> Forecast).
  forecasts                  Forecast[]        @relation("ForecastAuthor")
  payrollIdentities          PayrollIdentity[] @relation("PayrollIdentityUser")
  payrollIdentitiesConfirmed PayrollIdentity[] @relation("PayrollIdentityConfirmedBy")

  // Education guides — see docs/features/education.md
  guidesCreated          Guide[]        @relation("GuideCreator")
  guidesArchived         Guide[]        @relation("GuideArchiver")
  guideVersionsCreated   GuideVersion[] @relation("GuideVersionCreator")
  guideVersionsSubmitted GuideVersion[] @relation("GuideVersionSubmitter")
  guideVersionsApproved  GuideVersion[] @relation("GuideVersionApprover")
  guideVersionsPublished GuideVersion[] @relation("GuideVersionPublisher")
  guideVersionsRejected  GuideVersion[] @relation("GuideVersionRejecter")
  guideAssetsUploaded    GuideAsset[]   @relation("GuideAssetUploader")
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  name      String
  title     String?
  body      String   @db.Text
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, name])
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Equipment {
  id        String          @id @default(uuid())
  qrSlug    String?         @unique
  status    EquipmentStatus @default(AVAILABLE)
  type      String?
  brand     String?
  model     String?
  shortDesc String?
  longDesc  String?
  energy    String?
  features  String?
  condition String?
  issues    String?
  age       String?

  dailyRate Float?

  // Per-job-with-daily-cap billing knob for contractors.
  //   NULL  → legacy flat-daily billing (rentalCost = rentalDays × dailyRate).
  //   N > 0 → per-job rate is (dailyRate / N), capped per ET calendar day at
  //           dailyRate. Contractors pay per formal-crew (or solo) job
  //           completed while the equipment was checked out. The "Right Now"
  //           cap protects them from overpaying on heavy-volume days.
  // Admin opts a piece into the new model by setting this column. See
  // services/equipment.ts computeRentalCost and the memo at
  // memory/feature_per_job_equipment_billing.md.
  equivalentJobs Int?

  // Per-equipment policy requirements — array of PolicyDocument.id values.
  // At reserve/checkout time, the equipment service iterates this list plus
  // any active BLOCK policies that gate VEHICLE_RESERVE globally, and calls
  // policyPredicate.assertPoliciesSigned. Replaces the old
  // `requiresInsurance` boolean with a fully flexible per-piece opt-in that
  // works for insurance, vehicle policy, or any other policy the admin
  // publishes. Empty array (default) = no equipment-level requirements.
  requiredPolicyIds String[] @default([])

  checkouts        Checkout[]
  photos           EquipmentPhoto[]
  pins             PinnedEquipment[]
  likes            LikedEquipment[]
  instructions     EquipmentInstruction[]
  collections      EquipmentCollectionItem[]
  businessExpenses BusinessExpense[]
  groupPreferences GroupPreferredEquipment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  retiredAt DateTime?
}

model EquipmentPhoto {
  id           String    @id @default(cuid())
  equipmentId  String
  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  r2Key        String
  fileName     String?
  contentType  String?
  description  String?
  sortOrder    Int       @default(0)
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())

  @@index([equipmentId])
}

model Checkout {
  id           String    @id @default(cuid())
  // Accounting-system-agnostic ledger ID — SLC-YYMMDD-XXXX. Stamped at row
  // creation, used as the QuickBooks JournalNo. Nullable in the schema for
  // the brief backfill window; every row carries a value post-backfill.
  ledgerId     String?   @unique
  equipmentId  String
  userId       String
  reservedAt   DateTime  @default(now())
  checkedOutAt DateTime?
  releasedAt   DateTime?
  rentalDays   Int?
  rentalCost   Float?

  // Per-day breakdown captured at release time. Shape:
  //   [{ day: "YYYY-MM-DD", jobs: number|null, subtotal: number, capped: bool }]
  // `jobs` is null for flat-daily billing; a count for per-job billing.
  // Stored so receipts / "my charges" views can reconstruct the math
  // without re-running fetchJobsByDayForCheckout. See
  // services/equipment.ts computeRentalCost.
  rentalBreakdown Json?

  // Group rentals: when set, the checkout is owned by the group's claimer
  // (still tracked in userId) but the cost is split among workers per
  // CheckoutSplit rows materialized at release time. Null = solo checkout.
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  equipment Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  splits    CheckoutSplit[]

  // Helpful indexes; the “one active checkout” guarantee is added via a partial unique index in SQL
  @@index([equipmentId, releasedAt])
  @@index([userId, checkedOutAt])
  @@index([groupId])
}

// Per-worker share of a group rental. Created at release time from the
// group's per-member equipmentCostPercent (or even-split among workers
// when no percents are configured). Observers are excluded — they don't
// earn or pay for equipment.
model CheckoutSplit {
  id         String   @id @default(cuid())
  checkoutId String
  checkout   Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  percent    Float
  amount     Float
  createdAt  DateTime @default(now())

  @@unique([checkoutId, userId])
  @@index([userId])
}

model AuditEvent {
  id String @id @default(cuid())

  scope  AuditScope
  verb   AuditVerb
  action String?    @db.VarChar(64)

  actorUserId String?
  metadata    Json?

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([scope, createdAt])
  @@index([verb, createdAt])
  @@index([scope, verb, createdAt])
}

